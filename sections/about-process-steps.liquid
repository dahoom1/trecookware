{% comment %}
  Section: About — Process Steps
  Multi-column image + text stages (e.g. Design, Materials, Manufacturing, Pack & Ship).
  Repeatable via blocks; each block is one stage with an image, optional step number, heading and text.
{% endcomment %}

{%- style -%}
  .abps-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .abps-{{ section.id }}__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .abps-{{ section.id }}__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 48px;
  }
  .abps-{{ section.id }}__title {
    margin: 0 0 12px;
    font-family: var(--font-heading-family);
    line-height: 1.2;
  }
  .abps-{{ section.id }}__subtitle {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: var(--t-body);
    line-height: 1.6;
    opacity: 0.8;
  }

  .abps-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .abps-{{ section.id }}__item { text-align: left; }

  .abps-{{ section.id }}__media {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.image_ratio }};
    overflow: hidden;
    border-radius: 0;
    margin-bottom: 18px;
    background: rgba(var(--color-foreground), 0.05);
  }
  .abps-{{ section.id }}__media img,
  .abps-{{ section.id }}__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .abps-{{ section.id }}__step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 30px;
    height: 30px;
    padding: 0 8px;
    margin-bottom: 12px;
    font-family: var(--font-heading-family);
    font-size: var(--t-small);
    border-radius: 999px;
    border: 1px solid rgba(var(--color-foreground), 0.4);
  }

  .abps-{{ section.id }}__item-title {
    margin: 0 0 10px;
    font-family: var(--font-heading-family);
    font-size: var(--t-subtitle);
    line-height: 1.3;
  }
  .abps-{{ section.id }}__item-text {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: var(--t-body);
    line-height: 1.65;
    opacity: 0.85;
  }
  .abps-{{ section.id }}__item-text p { margin: 0 0 10px; }
  .abps-{{ section.id }}__item-text p:last-child { margin: 0; }

  @media screen and (min-width: 750px) {
    .abps-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .abps-{{ section.id }}__grid {
      grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
      gap: 32px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="abps-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="abps-{{ section.id }}__inner">
      {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
        <div class="abps-{{ section.id }}__header">
          {%- if section.settings.title != blank -%}
            <h2 class="abps-{{ section.id }}__title {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
          {%- endif -%}
          {%- if section.settings.subtitle != blank -%}
            <p class="abps-{{ section.id }}__subtitle">{{ section.settings.subtitle }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="abps-{{ section.id }}__grid">
        {%- for block in section.blocks -%}
          <div class="abps-{{ section.id }}__item" {{ block.shopify_attributes }}>
            <div class="abps-{{ section.id }}__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 100vw', widths: '300, 500, 800', alt: block.settings.heading }}
              {%- else -%}
                {{ 'collection-apparel-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>

            {%- if section.settings.show_step_number -%}
              <span class="abps-{{ section.id }}__step">{{ forloop.index }}</span>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h3 class="abps-{{ section.id }}__item-title">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="abps-{{ section.id }}__item-text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About — Process Steps",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "From raw steel to your kitchen"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Every piece passes through the same careful hands."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" }
      ],
      "default": "4 / 3"
    },
    {
      "type": "checkbox",
      "id": "show_step_number",
      "label": "Show step numbers",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Design"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Every shape starts with how it's used — balanced handles, even bases, details that earn their place.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About — Process Steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "heading": "Design",
            "text": "<p>Every shape starts with how it's used — balanced handles, even bases, details that earn their place.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Materials",
            "text": "<p>We source food-grade stainless steel and natural materials chosen to be safe for years of daily cooking.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Manufacturing",
            "text": "<p>Skilled makers craft each piece to rigorous standards, then test it before it ever earns the TRE name.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Pack & Ship",
            "text": "<p>Protected in minimal, recyclable packaging and sent straight to your door — nothing wasteful in between.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

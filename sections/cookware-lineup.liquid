{% comment %}
  Section: Cookware lineup
  Shows a chosen set of pieces. Which pieces appear can come from three places:

    Metafield  - reads a product list metafield off whatever the page is about
                 (collection, page, or product). One section on the collection
                 template then shows a different lineup per collection.
    Chosen here- a product picker, for a one-off page.
    Drawings   - the static line drawings, no products involved.

  Metafield to create (Settings > Custom data > Collections):
    namespace/key  custom.lineup_products
    type           Product (list of products)

  Optional, per product (Settings > Custom data > Products):
    namespace/key  custom.lineup_art
    type           Single line text
    value          one of: frying-pan-20, frying-pan-26, frying-pan-28,
                   sauce-pan-16, saute-pan-26, stockpot-20, stockpot-26,
                   steamer-26
  With that set the product shows its line drawing; without it the product's
  featured image is used instead.
{% endcomment %}

{%- liquid
  assign mf_ns = section.settings.mf_namespace | default: 'custom'
  assign mf_key = section.settings.mf_key | default: 'lineup_products'
  assign picked = ''

  case section.settings.source
    when 'metafield'
      # match the resource the page is actually about — on a product reached
      # through a collection, `collection` is still set and would otherwise win
      if request.page_type == 'product' and product != blank
        assign picked = product.metafields[mf_ns][mf_key].value
      elsif request.page_type == 'page' and page != blank
        assign picked = page.metafields[mf_ns][mf_key].value
      elsif collection != blank
        assign picked = collection.metafields[mf_ns][mf_key].value
      endif
    when 'picker'
      assign picked = section.settings.products
  endcase
-%}

{%- style -%}
  .cl-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }
  .cl-{{ section.id }}__inner {
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .cl-{{ section.id }}__note {
    max-width: 640px;
    margin: 0 auto;
    padding: 16px 20px;
    border: 1px dashed rgba(18, 18, 18, 0.3);
    font-family: var(--font-body-family);
    font-size: var(--t-small);
    line-height: 1.6;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .cl-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .cl-{{ section.id }}__inner { padding: 0 40px; }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="cl-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="cl-{{ section.id }}__inner">

      {%- if request.design_mode and section.settings.source == 'metafield' and picked == blank -%}
        <p class="cl-{{ section.id }}__note">
          No products found in <strong>{{ mf_ns }}.{{ mf_key }}</strong> for this page, so the
          line drawings are showing instead. Add that product list metafield to this
          collection to control the lineup. Only you can see this note.
        </p>
      {%- endif -%}

      {%- render 'cookware-lineup',
        products: picked,
        only: section.settings.only,
        columns: section.settings.columns,
        heading: section.settings.heading,
        show_price: section.settings.show_price,
        art_ns: section.settings.art_namespace,
        art_key: section.settings.art_key
      -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cookware lineup",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to show the pieces on their own."
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "auto", "label": "Match the number of pieces" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Which pieces"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Choose pieces from",
      "options": [
        { "value": "metafield", "label": "This collection's metafield" },
        { "value": "picker", "label": "Products chosen below" },
        { "value": "drawings", "label": "Line drawings only" }
      ],
      "default": "metafield",
      "info": "The metafield option lets one section on the collection template show a different lineup per collection."
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 8,
      "info": "Used when 'Products chosen below' is selected."
    },
    {
      "type": "text",
      "id": "only",
      "label": "Line drawings to show",
      "info": "Used when 'Line drawings only' is selected, and as the fallback when a collection has no metafield set. Comma separated, in order. Blank shows all eight. Keys: frying-pan-20, frying-pan-26, frying-pan-28, sauce-pan-16, saute-pan-26, stockpot-20, stockpot-26, steamer-26"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price under product titles",
      "default": false
    },
    {
      "type": "header",
      "content": "Metafield keys"
    },
    {
      "type": "paragraph",
      "content": "Only change these if your metafields use different names."
    },
    {
      "type": "text",
      "id": "mf_namespace",
      "label": "Collection metafield namespace",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "mf_key",
      "label": "Collection metafield key",
      "default": "lineup_products"
    },
    {
      "type": "text",
      "id": "art_namespace",
      "label": "Product drawing namespace",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "art_key",
      "label": "Product drawing key",
      "default": "lineup_art"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Content width",
      "default": 1120
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "presets": [
    { "name": "Cookware lineup" }
  ]
}
{% endschema %}

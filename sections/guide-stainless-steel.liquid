{% comment %}
  Section: Guide — Stainless Steel Cookware
  Web version of the printed booklet "A Guide to Your Tre Cookware".
  Copy (EN + AR, both taken from the booklet's own two halves) is assigned in
  the locale conditional below, so the page follows the store's language
  switcher without spending keys from the shared locale files — ar.json is
  near Shopify's 3,400-key ceiling.
  Assets live in /assets as guide-*.jpg / guide-*.png. The five ply diagram has
  a mirrored Arabic variant (guide-five-ply-ar.png) swapped by locale.
{% endcomment %}

{%- liquid
  assign s = 'tg-' | append: section.id
  assign anim = ''
  if settings.animations_reveal_on_scroll
    assign anim = ' scroll-trigger animate--slide-in'
  endif
-%}

{%- style -%}
  .{{ s }} {
    --tg-rule: rgba(18, 18, 18, 0.14);
    --tg-muted: rgba(18, 18, 18, 0.62);
    font-family: var(--font-body-family);
  }
  .{{ s }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }
  .{{ s }} .tg__wrap {
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .{{ s }} img { display: block; width: 100%; height: auto; }

  /* ── Hero ─────────────────────────────────────────── */
  .{{ s }} .tg__hero { display: grid; gap: 32px; align-items: center; }
  .{{ s }} .tg__eyebrow {
    display: block;
    margin: 0 0 22px;
    font-size: var(--t-small);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tg-muted);
  }
  .{{ s }} .tg__hero-title {
    margin: 0 0 20px;
    font-family: var(--font-heading-family);
    font-size: var(--t-display);
    font-weight: 400;
    line-height: 1.05;
  }
  .{{ s }} .tg__lede {
    margin: 0 0 16px;
    font-size: var(--t-subtitle);
    line-height: 1.7;
  }
  .{{ s }} .tg__lede:last-child { margin-bottom: 0; }

  /* ── Index ────────────────────────────────────────── */
  .{{ s }} .tg__index {
    margin-top: 8px;
    border-top: 1px solid var(--tg-rule);
  }
  .{{ s }} .tg__index-title {
    margin: 0;
    padding: 28px 0 8px;
    font-family: var(--font-heading-family);
    font-size: var(--t-h3);
    font-weight: 400;
  }
  .{{ s }} .tg__index-list {
    margin: 0;
    padding: 0 0 8px;
    list-style: none;
    counter-reset: tgidx;
  }
  .{{ s }} .tg__index-list li { counter-increment: tgidx; }
  .{{ s }} .tg__index-list a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--tg-rule);
    color: inherit;
    text-decoration: none;
    font-size: var(--t-body);
  }
  .{{ s }} .tg__index-list a::before {
    content: counter(tgidx);
    min-width: 1.6em;
    font-size: var(--t-small);
    color: var(--tg-muted);
    font-variant-numeric: tabular-nums;
  }
  .{{ s }} .tg__index-list a:hover { opacity: 0.6; }

  /* ── Chapters ─────────────────────────────────────── */
  .{{ s }} .tg__chapter { padding-top: 56px; scroll-margin-top: 90px; }
  .{{ s }} .tg__chapter-head {
    margin: 0 0 32px;
    padding-top: 20px;
    border-top: 1px solid var(--tg-rule);
  }
  .{{ s }} .tg__num {
    display: block;
    margin-bottom: 18px;
    font-size: var(--t-small);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tg-muted);
  }
  .{{ s }} .tg__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: var(--t-h1);
    font-weight: 400;
    line-height: 1.1;
  }
  .{{ s }} .tg__sub {
    margin: 40px 0 20px;
    font-family: var(--font-heading-family);
    font-size: var(--t-h3);
    font-weight: 400;
    line-height: 1.2;
  }
  .{{ s }} .tg__text { font-size: var(--t-body); line-height: 1.8; }
  .{{ s }} .tg__text p { margin: 0 0 16px; }
  .{{ s }} .tg__text p:last-child { margin-bottom: 0; }

  /* two-column text/media */
  .{{ s }} .tg__split { display: grid; gap: 32px; align-items: center; }
  .{{ s }} .tg__split--top { align-items: start; }

  /* ── Collection grid — markup + styles live in snippets/cookware-lineup.liquid ── */
  .{{ s }} .tg__pieces { margin-top: 40px; }

  /* ── Layer list (five ply) ────────────────────────── */
  .{{ s }} .tg__layers { margin: 0; padding: 0; list-style: none; }
  .{{ s }} .tg__layer {
    padding: 18px 0;
    border-bottom: 1px solid var(--tg-rule);
  }
  .{{ s }} .tg__layer:first-child { border-top: 1px solid var(--tg-rule); }
  .{{ s }} .tg__layer dt {
    margin-bottom: 6px;
    font-family: var(--font-heading-family);
    font-size: var(--t-subtitle);
  }
  .{{ s }} .tg__layer dd {
    margin: 0;
    font-size: var(--t-body);
    line-height: 1.7;
    color: var(--tg-muted);
  }

  /* ── Numbered steps ───────────────────────────────── */
  .{{ s }} .tg__steps { display: grid; gap: 36px; margin-top: 40px; }
  .{{ s }} .tg__step-num {
    display: block;
    margin-bottom: 14px;
    font-family: var(--font-heading-family);
    font-style: italic;
    font-size: var(--t-body);
    color: var(--tg-muted);
  }
  .{{ s }} .tg__step-title {
    margin: 0 0 12px;
    font-family: var(--font-heading-family);
    font-size: var(--t-h2);
    font-weight: 400;
    line-height: 1.15;
  }

  /* how-to steps carry a small image */
  .{{ s }} .tg__usestep { display: grid; grid-template-columns: 1fr 96px; gap: 20px; align-items: start; }
  .{{ s }} .tg__usestep-art img { border-radius: 2px; }

  /* ── Full-bleed image ─────────────────────────────── */
  .{{ s }} .tg__bleed { margin-top: 48px; }
  .{{ s }} .tg__bleed img { border-radius: 2px; }

  /* ── Concerns ─────────────────────────────────────── */
  .{{ s }} .tg__concerns { display: grid; gap: 28px; margin-top: 40px; }
  .{{ s }} .tg__concern {
    padding-top: 20px;
    border-top: 1px solid var(--tg-rule);
  }
  .{{ s }} .tg__concern h3 {
    margin: 0 0 10px;
    font-family: var(--font-heading-family);
    font-size: var(--t-h3);
    font-weight: 400;
  }

  /* ── Closing ──────────────────────────────────────── */
  .{{ s }} .tg__closing { margin-top: 64px; padding-top: 40px; border-top: 1px solid var(--tg-rule); }
  .{{ s }} .tg__closing-title {
    margin: 0 0 24px;
    font-family: var(--font-heading-family);
    font-size: var(--t-h1);
    font-weight: 400;
    line-height: 1.1;
  }
  .{{ s }} .tg__meta {
    margin-top: 24px;
    font-size: var(--t-small);
    line-height: 1.9;
    color: var(--tg-muted);
  }
  .{{ s }} .tg__meta a { color: inherit; }

  /* ── Desktop ──────────────────────────────────────── */
  @media screen and (min-width: 750px) {
    .{{ s }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .{{ s }} .tg__wrap { padding: 0 40px; }
    .{{ s }} .tg__hero { grid-template-columns: 1fr 1fr; gap: 64px; }
    .{{ s }} .tg__chapter { padding-top: 96px; }
    .{{ s }} .tg__split { grid-template-columns: 1fr 1fr; gap: 64px; }
    .{{ s }} .tg__split--wide-media { grid-template-columns: 1.15fr 1fr; }
    .{{ s }} .tg__steps--two { grid-template-columns: repeat(2, 1fr); gap: 56px 64px; }
    .{{ s }} .tg__usestep { grid-template-columns: 1fr 120px; }
    .{{ s }} .tg__concerns { grid-template-columns: repeat(3, 1fr); gap: 40px; }
    .{{ s }} .tg__index-list { columns: 2; column-gap: 64px; }
    .{{ s }} .tg__index-list li { break-inside: avoid; }
  }
{%- endstyle -%}


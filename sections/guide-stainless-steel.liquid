{% comment %}
  Section: Guide — Stainless Steel Cookware
  Web version of the printed booklet "A Guide to Your Tre Cookware".
  Copy lives in locales/*.json under `sections.guide.*` (EN + AR taken from the
  booklet's own two halves), so the page follows the store's language switcher.
  Assets live in /assets as guide-*.jpg / guide-*.png. The five ply diagram has
  a mirrored Arabic variant (guide-five-ply-ar.png) swapped by locale.
{% endcomment %}

{%- liquid
  assign s = 'tg-' | append: section.id
  assign anim = ''
  if settings.animations_reveal_on_scroll
    assign anim = ' scroll-trigger animate--slide-in'
  endif
-%}

{%- style -%}
  .{{ s }} {
    --tg-rule: rgba(18, 18, 18, 0.14);
    --tg-muted: rgba(18, 18, 18, 0.62);
    font-family: var(--font-body-family);
  }
  .{{ s }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }
  .{{ s }} .tg__wrap {
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .{{ s }} img { display: block; width: 100%; height: auto; }

  /* ── Hero ─────────────────────────────────────────── */
  .{{ s }} .tg__hero { display: grid; gap: 32px; align-items: center; }
  .{{ s }} .tg__eyebrow {
    display: block;
    margin: 0 0 14px;
    font-size: var(--t-small);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tg-muted);
  }
  .{{ s }} .tg__hero-title {
    margin: 0 0 20px;
    font-family: var(--font-heading-family);
    font-size: var(--t-display);
    font-weight: 400;
    line-height: 1.05;
  }
  .{{ s }} .tg__lede {
    margin: 0 0 16px;
    font-size: var(--t-subtitle);
    line-height: 1.7;
  }
  .{{ s }} .tg__lede:last-child { margin-bottom: 0; }

  /* ── Index ────────────────────────────────────────── */
  .{{ s }} .tg__index {
    margin-top: 8px;
    border-top: 1px solid var(--tg-rule);
  }
  .{{ s }} .tg__index-title {
    margin: 0;
    padding: 28px 0 8px;
    font-family: var(--font-heading-family);
    font-size: var(--t-h3);
    font-weight: 400;
  }
  .{{ s }} .tg__index-list {
    margin: 0;
    padding: 0 0 8px;
    list-style: none;
    counter-reset: tgidx;
  }
  .{{ s }} .tg__index-list li { counter-increment: tgidx; }
  .{{ s }} .tg__index-list a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--tg-rule);
    color: inherit;
    text-decoration: none;
    font-size: var(--t-body);
  }
  .{{ s }} .tg__index-list a::before {
    content: counter(tgidx);
    min-width: 1.6em;
    font-size: var(--t-small);
    color: var(--tg-muted);
    font-variant-numeric: tabular-nums;
  }
  .{{ s }} .tg__index-list a:hover { opacity: 0.6; }

  /* ── Chapters ─────────────────────────────────────── */
  .{{ s }} .tg__chapter { padding-top: 56px; scroll-margin-top: 90px; }
  .{{ s }} .tg__chapter-head {
    margin: 0 0 32px;
    padding-top: 20px;
    border-top: 1px solid var(--tg-rule);
  }
  .{{ s }} .tg__num {
    display: block;
    margin-bottom: 10px;
    font-size: var(--t-small);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tg-muted);
  }
  .{{ s }} .tg__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: var(--t-h1);
    font-weight: 400;
    line-height: 1.1;
  }
  .{{ s }} .tg__sub {
    margin: 40px 0 20px;
    font-family: var(--font-heading-family);
    font-size: var(--t-h3);
    font-weight: 400;
    line-height: 1.2;
  }
  .{{ s }} .tg__text { font-size: var(--t-body); line-height: 1.8; }
  .{{ s }} .tg__text p { margin: 0 0 16px; }
  .{{ s }} .tg__text p:last-child { margin-bottom: 0; }

  /* two-column text/media */
  .{{ s }} .tg__split { display: grid; gap: 32px; align-items: center; }
  .{{ s }} .tg__split--top { align-items: start; }

  /* ── Collection grid (line drawings) ──────────────── */
  .{{ s }} .tg__pieces {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 20px;
    margin-top: 40px;
  }
  .{{ s }} .tg__piece { text-align: center; }
  .{{ s }} .tg__piece-art {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: 90px;
  }
  .{{ s }} .tg__piece-art img { width: auto; max-width: 100%; max-height: 100%; }
  .{{ s }} .tg__piece-label {
    margin: 14px 0 0;
    font-size: var(--t-small);
    line-height: 1.5;
  }

  /* ── Layer list (five ply) ────────────────────────── */
  .{{ s }} .tg__layers { margin: 0; padding: 0; list-style: none; }
  .{{ s }} .tg__layer {
    padding: 18px 0;
    border-bottom: 1px solid var(--tg-rule);
  }
  .{{ s }} .tg__layer:first-child { border-top: 1px solid var(--tg-rule); }
  .{{ s }} .tg__layer dt {
    margin-bottom: 6px;
    font-family: var(--font-heading-family);
    font-size: var(--t-subtitle);
  }
  .{{ s }} .tg__layer dd {
    margin: 0;
    font-size: var(--t-body);
    line-height: 1.7;
    color: var(--tg-muted);
  }

  /* ── Numbered steps ───────────────────────────────── */
  .{{ s }} .tg__steps { display: grid; gap: 36px; margin-top: 40px; }
  .{{ s }} .tg__step-num {
    display: block;
    margin-bottom: 8px;
    font-family: var(--font-heading-family);
    font-style: italic;
    font-size: var(--t-body);
    color: var(--tg-muted);
  }
  .{{ s }} .tg__step-title {
    margin: 0 0 12px;
    font-family: var(--font-heading-family);
    font-size: var(--t-h2);
    font-weight: 400;
    line-height: 1.15;
  }

  /* how-to steps carry a small image */
  .{{ s }} .tg__usestep { display: grid; grid-template-columns: 1fr 96px; gap: 20px; align-items: start; }
  .{{ s }} .tg__usestep-art img { border-radius: 2px; }

  /* ── Full-bleed image ─────────────────────────────── */
  .{{ s }} .tg__bleed { margin-top: 48px; }
  .{{ s }} .tg__bleed img { border-radius: 2px; }

  /* ── Concerns ─────────────────────────────────────── */
  .{{ s }} .tg__concerns { display: grid; gap: 28px; margin-top: 40px; }
  .{{ s }} .tg__concern {
    padding-top: 20px;
    border-top: 1px solid var(--tg-rule);
  }
  .{{ s }} .tg__concern h3 {
    margin: 0 0 10px;
    font-family: var(--font-heading-family);
    font-size: var(--t-h3);
    font-weight: 400;
  }

  /* ── Closing ──────────────────────────────────────── */
  .{{ s }} .tg__closing { margin-top: 64px; padding-top: 40px; border-top: 1px solid var(--tg-rule); }
  .{{ s }} .tg__closing-title {
    margin: 0 0 24px;
    font-family: var(--font-heading-family);
    font-size: var(--t-h1);
    font-weight: 400;
    line-height: 1.1;
  }
  .{{ s }} .tg__meta {
    margin-top: 24px;
    font-size: var(--t-small);
    line-height: 1.9;
    color: var(--tg-muted);
  }
  .{{ s }} .tg__meta a { color: inherit; }

  /* ── Desktop ──────────────────────────────────────── */
  @media screen and (min-width: 750px) {
    .{{ s }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .{{ s }} .tg__wrap { padding: 0 40px; }
    .{{ s }} .tg__hero { grid-template-columns: 1fr 1fr; gap: 64px; }
    .{{ s }} .tg__chapter { padding-top: 96px; }
    .{{ s }} .tg__split { grid-template-columns: 1fr 1fr; gap: 64px; }
    .{{ s }} .tg__split--wide-media { grid-template-columns: 1.15fr 1fr; }
    .{{ s }} .tg__pieces { grid-template-columns: repeat(4, 1fr); gap: 40px 32px; }
    .{{ s }} .tg__piece-art { height: 110px; }
    .{{ s }} .tg__steps--two { grid-template-columns: repeat(2, 1fr); gap: 56px 64px; }
    .{{ s }} .tg__usestep { grid-template-columns: 1fr 120px; }
    .{{ s }} .tg__concerns { grid-template-columns: repeat(3, 1fr); gap: 40px; }
    .{{ s }} .tg__index-list { columns: 2; column-gap: 64px; }
    .{{ s }} .tg__index-list li { break-inside: avoid; }
  }
{%- endstyle -%}

{%- liquid
  if request.locale.iso_code contains 'ar'
    assign five_ply_src = 'guide-five-ply-ar.png'
    assign five_ply_h = 1250
  else
    assign five_ply_src = 'guide-five-ply.png'
    assign five_ply_h = 1235
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} gradient {{ s }}">
  <div class="{{ s }}-padding">
    <div class="tg__wrap">

      {%- comment -%} ── Hero ───────────────────────────────────────── {%- endcomment -%}
      <header class="tg__hero{{ anim }}">
        <div>
          <span class="tg__eyebrow">{{ 'sections.guide.hero_eyebrow' | t }}</span>
          <h1 class="tg__hero-title">{{ 'sections.guide.hero_title' | t }}</h1>
          <p class="tg__lede">{{ 'sections.guide.hero_p1' | t }}</p>
          <p class="tg__lede">{{ 'sections.guide.hero_p2' | t }}</p>
        </div>
        <div>
          <img
            src="{{ 'guide-hero-collection.jpg' | asset_url }}"
            alt="{{ 'sections.guide.alt_hero' | t }}"
            width="1400"
            height="1969"
            loading="eager"
          >
        </div>
      </header>

      {%- comment -%} ── Index ──────────────────────────────────────── {%- endcomment -%}
      <nav class="tg__index" aria-label="{{ 'sections.guide.index_title' | t }}">
        <h2 class="tg__index-title">{{ 'sections.guide.index_title' | t }}</h2>
        <ol class="tg__index-list">
          <li><a href="#tg-essential">{{ 'sections.guide.ch1_title' | t }}</a></li>
          <li><a href="#tg-materials">{{ 'sections.guide.ch2_title' | t }}</a></li>
          <li><a href="#tg-design">{{ 'sections.guide.ch3_title' | t }}</a></li>
          <li><a href="#tg-care">{{ 'sections.guide.ch4_title' | t }}</a></li>
          <li><a href="#tg-how-to-use">{{ 'sections.guide.ch5_title' | t }}</a></li>
          <li><a href="#tg-concerns">{{ 'sections.guide.ch6_title' | t }}</a></li>
          <li><a href="#tg-warranty">{{ 'sections.guide.ch7_title' | t }}</a></li>
        </ol>
      </nav>

      {%- comment -%} ── 1. Only What's Essential ───────────────────── {%- endcomment -%}
      <section class="tg__chapter{{ anim }}" id="tg-essential">
        <div class="tg__chapter-head">
          <span class="tg__num">{{ 'sections.guide.one' | t }}</span>
          <h2 class="tg__title">{{ 'sections.guide.ch1_title' | t }}</h2>
        </div>

        <div class="tg__split tg__split--top">
          <h3 class="tg__sub" style="margin-top: 0;">{{ 'sections.guide.essential_sub' | t }}</h3>
          <div class="tg__text">
            <p>{{ 'sections.guide.essential_p1' | t }}</p>
            <p>{{ 'sections.guide.essential_p2' | t }}</p>
          </div>
        </div>

        {%- liquid
          assign p_files = 'guide-frying-pan-20.png,guide-frying-pan-26.png,guide-frying-pan-28.png,guide-sauce-pan-16.png,guide-saute-pan-26.png,guide-stockpot-20.png,guide-stockpot-26.png,guide-steamer-26.png' | split: ','
          assign p_w = '796,900,900,752,900,736,832,836' | split: ','
          assign p_h = '244,233,232,388,330,412,472,312' | split: ','
          assign p_size = 'size_20,size_26,size_28,size_16,size_26,size_20,size_26,size_26' | split: ','
          assign p_name = 'piece_frying_pan,piece_frying_pan,piece_frying_pan,piece_sauce_pan,piece_saute_pan,piece_stockpot_small,piece_stockpot_large,piece_steamer' | split: ','
        -%}
        <div class="tg__pieces">
          {%- for file in p_files -%}
            {%- liquid
              assign size_key = 'sections.guide.' | append: p_size[forloop.index0]
              assign name_key = 'sections.guide.' | append: p_name[forloop.index0]
              assign size = size_key | t
              assign name = name_key | t
            -%}
            <div class="tg__piece">
              <div class="tg__piece-art">
                <img
                  src="{{ file | asset_url }}"
                  alt="{{ size }} {{ name }}"
                  width="{{ p_w[forloop.index0] }}"
                  height="{{ p_h[forloop.index0] }}"
                  loading="lazy"
                >
              </div>
              <p class="tg__piece-label">{{ size }}<br>{{ name }}</p>
            </div>
          {%- endfor -%}
        </div>
      </section>

      {%- comment -%} ── 2. Materials ───────────────────────────────── {%- endcomment -%}
      <section class="tg__chapter{{ anim }}" id="tg-materials">
        <div class="tg__chapter-head">
          <span class="tg__num">{{ 'sections.guide.two' | t }}</span>
          <h2 class="tg__title">{{ 'sections.guide.ch2_title' | t }}</h2>
        </div>

        <div class="tg__split">
          <div>
            <h3 class="tg__sub" style="margin-top: 0;">{{ 'sections.guide.uncoated_sub' | t }}</h3>
            <div class="tg__text">
              <p>{{ 'sections.guide.uncoated_p1' | t }}</p>
              <p>{{ 'sections.guide.uncoated_p2' | t }}</p>
              <p>{{ 'sections.guide.uncoated_p3' | t }}</p>
              <p>{{ 'sections.guide.uncoated_p4' | t }}</p>
            </div>
          </div>
          <div>
            <img
              src="{{ 'guide-pan-closeup.jpg' | asset_url }}"
              alt="{{ 'sections.guide.alt_closeup' | t }}"
              width="1400"
              height="1353"
              loading="lazy"
            >
          </div>
        </div>

        <h3 class="tg__sub">{{ 'sections.guide.five_ply_sub' | t }}</h3>
        <div class="tg__split tg__split--wide-media">
          <div>
            <img
              src="{{ five_ply_src | asset_url }}"
              alt="{{ 'sections.guide.alt_five_ply' | t }}"
              width="1400"
              height="{{ five_ply_h }}"
              loading="lazy"
            >
          </div>
          <div>
            <p class="tg__text" style="margin-bottom: 24px;">{{ 'sections.guide.five_ply_intro' | t }}</p>
            <dl class="tg__layers">
              <div class="tg__layer">
                <dt>{{ 'sections.guide.layer_interior_t' | t }}</dt>
                <dd>{{ 'sections.guide.layer_interior_d' | t }}</dd>
              </div>
              <div class="tg__layer">
                <dt>{{ 'sections.guide.layer_aluminum_t' | t }}</dt>
                <dd>{{ 'sections.guide.layer_aluminum_d' | t }}</dd>
              </div>
              <div class="tg__layer">
                <dt>{{ 'sections.guide.layer_exterior_t' | t }}</dt>
                <dd>{{ 'sections.guide.layer_exterior_d' | t }}</dd>
              </div>
              <div class="tg__layer">
                <dt>{{ 'sections.guide.layer_lid_t' | t }}</dt>
                <dd>{{ 'sections.guide.layer_lid_d' | t }}</dd>
              </div>
              <div class="tg__layer">
                <dt>{{ 'sections.guide.layer_handles_t' | t }}</dt>
                <dd>{{ 'sections.guide.layer_handles_d' | t }}</dd>
              </div>
            </dl>
          </div>
        </div>
      </section>

      {%- comment -%} ── 3. Design ──────────────────────────────────── {%- endcomment -%}
      <section class="tg__chapter{{ anim }}" id="tg-design">
        <div class="tg__chapter-head">
          <span class="tg__num">{{ 'sections.guide.three' | t }}</span>
          <h2 class="tg__title">{{ 'sections.guide.ch3_title' | t }}</h2>
        </div>

        <div class="tg__split">
          <div>
            <img
              src="{{ 'guide-saucepan.jpg' | asset_url }}"
              alt="{{ 'sections.guide.alt_saucepan' | t }}"
              width="1200"
              height="1020"
              loading="lazy"
            >
          </div>
          <div class="tg__steps">
            <div>
              <h3 class="tg__step-title">{{ 'sections.guide.design_sealed_t' | t }}</h3>
              <div class="tg__text"><p>{{ 'sections.guide.design_sealed_d' | t }}</p></div>
            </div>
            <div>
              <h3 class="tg__step-title">{{ 'sections.guide.design_lids_t' | t }}</h3>
              <div class="tg__text"><p>{{ 'sections.guide.design_lids_d' | t }}</p></div>
            </div>
          </div>
        </div>

        <div class="tg__split" style="margin-top: 56px;">
          <div class="tg__steps">
            <div>
              <h3 class="tg__step-title">{{ 'sections.guide.design_handle_t' | t }}</h3>
              <div class="tg__text"><p>{{ 'sections.guide.design_handle_d' | t }}</p></div>
            </div>
            <div>
              <h3 class="tg__step-title">{{ 'sections.guide.design_edges_t' | t }}</h3>
              <div class="tg__text"><p>{{ 'sections.guide.design_edges_d' | t }}</p></div>
            </div>
          </div>
          <div>
            <img
              src="{{ 'guide-frypan.jpg' | asset_url }}"
              alt="{{ 'sections.guide.alt_frypan' | t }}"
              width="1200"
              height="645"
              loading="lazy"
            >
          </div>
        </div>
      </section>

      {%- comment -%} ── 4. Cleaning and Care ───────────────────────── {%- endcomment -%}
      <section class="tg__chapter{{ anim }}" id="tg-care">
        <div class="tg__chapter-head">
          <span class="tg__num">{{ 'sections.guide.four' | t }}</span>
          <h2 class="tg__title">{{ 'sections.guide.ch4_title' | t }}</h2>
        </div>

        <div class="tg__bleed" style="margin-top: 0;">
          <img
            src="{{ 'guide-care-sink.jpg' | asset_url }}"
            alt="{{ 'sections.guide.alt_care' | t }}"
            width="2000"
            height="1116"
            loading="lazy"
          >
        </div>

        <div class="tg__steps tg__steps--two">
          <div>
            <span class="tg__step-num">{{ 'sections.guide.one' | t }}</span>
            <h3 class="tg__step-title">{{ 'sections.guide.care_1_t' | t }}</h3>
            <div class="tg__text"><p>{{ 'sections.guide.care_1_d' | t }}</p></div>
          </div>
          <div>
            <span class="tg__step-num">{{ 'sections.guide.two' | t }}</span>
            <h3 class="tg__step-title">{{ 'sections.guide.care_2_t' | t }}</h3>
            <div class="tg__text">
              <p>{{ 'sections.guide.care_2_d1' | t }}</p>
              <p>{{ 'sections.guide.care_2_d2' | t }}</p>
            </div>
          </div>
          <div>
            <span class="tg__step-num">{{ 'sections.guide.three' | t }}</span>
            <h3 class="tg__step-title">{{ 'sections.guide.care_3_t' | t }}</h3>
            <div class="tg__text"><p>{{ 'sections.guide.care_3_d' | t }}</p></div>
          </div>
          <div>
            <span class="tg__step-num">{{ 'sections.guide.four' | t }}</span>
            <h3 class="tg__step-title">{{ 'sections.guide.care_4_t' | t }}</h3>
            <div class="tg__text"><p>{{ 'sections.guide.care_4_d' | t }}</p></div>
          </div>
        </div>
      </section>

      {%- comment -%} ── 5. How To Use ──────────────────────────────── {%- endcomment -%}
      <section class="tg__chapter{{ anim }}" id="tg-how-to-use">
        <div class="tg__chapter-head">
          <span class="tg__num">{{ 'sections.guide.five' | t }}</span>
          <h2 class="tg__title">{{ 'sections.guide.ch5_title' | t }}</h2>
        </div>

        <p class="tg__lede">{{ 'sections.guide.use_lede' | t }}</p>

        <div class="tg__steps tg__steps--two">
          <div>
            <h3 class="tg__step-title">{{ 'sections.guide.use_1_t' | t }}</h3>
            <div class="tg__text">
              <p>{{ 'sections.guide.use_1_d1' | t }}</p>
              <p>{{ 'sections.guide.use_1_d2' | t }}</p>
            </div>
          </div>
          <div class="tg__usestep">
            <div>
              <h3 class="tg__step-title">{{ 'sections.guide.use_2_t' | t }}</h3>
              <div class="tg__text"><p>{{ 'sections.guide.use_2_d' | t }}</p></div>
            </div>
            <div class="tg__usestep-art">
              <img src="{{ 'guide-step-oil.jpg' | asset_url }}" alt="{{ 'sections.guide.alt_oil' | t }}" width="600" height="594" loading="lazy">
            </div>
          </div>
          <div class="tg__usestep">
            <div>
              <h3 class="tg__step-title">{{ 'sections.guide.use_3_t' | t }}</h3>
              <div class="tg__text"><p>{{ 'sections.guide.use_3_d' | t }}</p></div>
            </div>
            <div class="tg__usestep-art">
              <img src="{{ 'guide-step-egg.jpg' | asset_url }}" alt="{{ 'sections.guide.alt_egg' | t }}" width="600" height="598" loading="lazy">
            </div>
          </div>
          <div class="tg__usestep">
            <div>
              <h3 class="tg__step-title">{{ 'sections.guide.use_4_t' | t }}</h3>
              <div class="tg__text"><p>{{ 'sections.guide.use_4_d' | t }}</p></div>
            </div>
            <div class="tg__usestep-art">
              <img src="{{ 'guide-step-utensils.jpg' | asset_url }}" alt="{{ 'sections.guide.alt_utensils' | t }}" width="441" height="924" loading="lazy">
            </div>
          </div>
        </div>
      </section>

      {%- comment -%} ── 6. Common Concerns ─────────────────────────── {%- endcomment -%}
      <section class="tg__chapter{{ anim }}" id="tg-concerns">
        <div class="tg__chapter-head">
          <span class="tg__num">{{ 'sections.guide.six' | t }}</span>
          <h2 class="tg__title">{{ 'sections.guide.ch6_title' | t }}</h2>
        </div>

        <div class="tg__concerns">
          <div class="tg__concern">
            <h3>{{ 'sections.guide.concern_1_t' | t }}</h3>
            <div class="tg__text">
              <p>{{ 'sections.guide.concern_1_d1' | t }}</p>
              <p>{{ 'sections.guide.concern_1_d2' | t }}</p>
            </div>
          </div>
          <div class="tg__concern">
            <h3>{{ 'sections.guide.concern_2_t' | t }}</h3>

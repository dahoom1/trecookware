{% schema %}
{
  "name": "Guide — Stainless Steel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Text is edited at the top of sections\/guide-stainless-steel.liquid (English and Arabic). Images live in Assets as guide-*.jpg \/ guide-*.png."
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 800,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Content width",
      "default": 1120
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 88
    }
  ],
  "presets": [
    { "name": "Guide — Stainless Steel" }
  ]
}
{% endschema %}

{% comment %}
  Section: Guide — Stainless Steel Cookware
  Web version of the printed booklet "A Guide to Your Tre Cookware" (EN).
  Copy and imagery are fixed in this file; only layout settings are exposed.
  Assets live in /assets as guide-*.jpg / guide-*.png.
{% endcomment %}

{%- liquid
  assign s = 'tg-' | append: section.id
  assign anim = ''
  if settings.animations_reveal_on_scroll
    assign anim = ' scroll-trigger animate--slide-in'
  endif
-%}

{%- style -%}
  .{{ s }} {
    --tg-rule: rgba(18, 18, 18, 0.14);
    --tg-muted: rgba(18, 18, 18, 0.62);
    font-family: var(--font-body-family);
  }
  .{{ s }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }
  .{{ s }} .tg__wrap {
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .{{ s }} img { display: block; width: 100%; height: auto; }

  /* ── Hero ─────────────────────────────────────────── */
  .{{ s }} .tg__hero { display: grid; gap: 32px; align-items: center; }
  .{{ s }} .tg__eyebrow {
    display: block;
    margin: 0 0 14px;
    font-size: var(--t-small);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tg-muted);
  }
  .{{ s }} .tg__hero-title {
    margin: 0 0 20px;
    font-family: var(--font-heading-family);
    font-size: var(--t-display);
    font-weight: 400;
    line-height: 1.05;
  }
  .{{ s }} .tg__lede {
    margin: 0 0 16px;
    font-size: var(--t-subtitle);
    line-height: 1.7;
  }
  .{{ s }} .tg__lede:last-child { margin-bottom: 0; }

  /* ── Index ────────────────────────────────────────── */
  .{{ s }} .tg__index {
    margin-top: 8px;
    border-top: 1px solid var(--tg-rule);
  }
  .{{ s }} .tg__index-title {
    margin: 0;
    padding: 28px 0 8px;
    font-family: var(--font-heading-family);
    font-size: var(--t-h3);
    font-weight: 400;
  }
  .{{ s }} .tg__index-list {
    margin: 0;
    padding: 0 0 8px;
    list-style: none;
    counter-reset: tgidx;
  }
  .{{ s }} .tg__index-list li { counter-increment: tgidx; }
  .{{ s }} .tg__index-list a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--tg-rule);
    color: inherit;
    text-decoration: none;
    font-size: var(--t-body);
  }
  .{{ s }} .tg__index-list a::before {
    content: counter(tgidx);
    min-width: 1.6em;
    font-size: var(--t-small);
    color: var(--tg-muted);
    font-variant-numeric: tabular-nums;
  }
  .{{ s }} .tg__index-list a:hover { opacity: 0.6; }

  /* ── Chapters ─────────────────────────────────────── */
  .{{ s }} .tg__chapter { padding-top: 56px; scroll-margin-top: 90px; }
  .{{ s }} .tg__chapter-head {
    margin: 0 0 32px;
    padding-top: 20px;
    border-top: 1px solid var(--tg-rule);
  }
  .{{ s }} .tg__num {
    display: block;
    margin-bottom: 10px;
    font-size: var(--t-small);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tg-muted);
  }
  .{{ s }} .tg__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: var(--t-h1);
    font-weight: 400;
    line-height: 1.1;
  }
  .{{ s }} .tg__sub {
    margin: 40px 0 20px;
    font-family: var(--font-heading-family);
    font-size: var(--t-h3);
    font-weight: 400;
    line-height: 1.2;
  }
  .{{ s }} .tg__text { font-size: var(--t-body); line-height: 1.8; }
  .{{ s }} .tg__text p { margin: 0 0 16px; }
  .{{ s }} .tg__text p:last-child { margin-bottom: 0; }

  /* two-column text/media */
  .{{ s }} .tg__split { display: grid; gap: 32px; align-items: center; }
  .{{ s }} .tg__split--top { align-items: start; }

  /* ── Collection grid (line drawings) ──────────────── */
  .{{ s }} .tg__pieces {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 20px;
    margin-top: 40px;
  }
  .{{ s }} .tg__piece { text-align: center; }
  .{{ s }} .tg__piece-art {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: 90px;
  }
  .{{ s }} .tg__piece-art img { width: auto; max-width: 100%; max-height: 100%; }
  .{{ s }} .tg__piece-label {
    margin: 14px 0 0;
    font-size: var(--t-small);
    line-height: 1.5;
  }

  /* ── Layer list (five ply) ────────────────────────── */
  .{{ s }} .tg__layers { margin: 0; padding: 0; list-style: none; }
  .{{ s }} .tg__layer {
    padding: 18px 0;
    border-bottom: 1px solid var(--tg-rule);
  }
  .{{ s }} .tg__layer:first-child { border-top: 1px solid var(--tg-rule); }
  .{{ s }} .tg__layer dt {
    margin-bottom: 6px;
    font-family: var(--font-heading-family);
    font-size: var(--t-subtitle);
  }
  .{{ s }} .tg__layer dd {
    margin: 0;
    font-size: var(--t-body);
    line-height: 1.7;
    color: var(--tg-muted);
  }

  /* ── Numbered steps ───────────────────────────────── */
  .{{ s }} .tg__steps { display: grid; gap: 36px; margin-top: 40px; }
  .{{ s }} .tg__step-num {
    display: block;
    margin-bottom: 8px;
    font-family: var(--font-heading-family);
    font-style: italic;
    font-size: var(--t-body);
    color: var(--tg-muted);
  }
  .{{ s }} .tg__step-title {
    margin: 0 0 12px;
    font-family: var(--font-heading-family);
    font-size: var(--t-h2);
    font-weight: 400;
    line-height: 1.15;
  }

  /* how-to steps carry a small image */
  .{{ s }} .tg__usestep { display: grid; grid-template-columns: 1fr 96px; gap: 20px; align-items: start; }
  .{{ s }} .tg__usestep-art img { border-radius: 2px; }

  /* ── Full-bleed image ─────────────────────────────── */
  .{{ s }} .tg__bleed { margin-top: 48px; }
  .{{ s }} .tg__bleed img { border-radius: 2px; }

  /* ── Concerns ─────────────────────────────────────── */
  .{{ s }} .tg__concerns { display: grid; gap: 28px; margin-top: 40px; }
  .{{ s }} .tg__concern {
    padding-top: 20px;
    border-top: 1px solid var(--tg-rule);
  }
  .{{ s }} .tg__concern h3 {
    margin: 0 0 10px;
    font-family: var(--font-heading-family);
    font-size: var(--t-h3);
    font-weight: 400;
  }

  /* ── Closing ──────────────────────────────────────── */
  .{{ s }} .tg__closing { margin-top: 64px; padding-top: 40px; border-top: 1px solid var(--tg-rule); }
  .{{ s }} .tg__closing-title {
    margin: 0 0 24px;
    font-family: var(--font-heading-family);
    font-size: var(--t-h1);
    font-weight: 400;
    line-height: 1.1;
  }
  .{{ s }} .tg__meta {
    margin-top: 24px;
    font-size: var(--t-small);
    line-height: 1.9;
    color: var(--tg-muted);
  }
  .{{ s }} .tg__meta a { color: inherit; }

  /* ── Desktop ──────────────────────────────────────── */
  @media screen and (min-width: 750px) {
    .{{ s }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .{{ s }} .tg__wrap { padding: 0 40px; }
    .{{ s }} .tg__hero { grid-template-columns: 1fr 1fr; gap: 64px; }
    .{{ s }} .tg__chapter { padding-top: 96px; }
    .{{ s }} .tg__split { grid-template-columns: 1fr 1fr; gap: 64px; }
    .{{ s }} .tg__split--wide-media { grid-template-columns: 1.15fr 1fr; }
    .{{ s }} .tg__pieces { grid-template-columns: repeat(4, 1fr); gap: 40px 32px; }
    .{{ s }} .tg__piece-art { height: 110px; }
    .{{ s }} .tg__steps--two { grid-template-columns: repeat(2, 1fr); gap: 56px 64px; }
    .{{ s }} .tg__usestep { grid-template-columns: 1fr 120px; }
    .{{ s }} .tg__concerns { grid-template-columns: repeat(3, 1fr); gap: 40px; }
    .{{ s }} .tg__index-list { columns: 2; column-gap: 64px; }
    .{{ s }} .tg__index-list li { break-inside: avoid; }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient {{ s }}">
  <div class="{{ s }}-padding">
    <div class="tg__wrap">

      {%- comment -%} ── Hero ───────────────────────────────────────── {%- endcomment -%}
      <header class="tg__hero{{ anim }}">
        <div>
          <span class="tg__eyebrow">A Guide to Your</span>
          <h1 class="tg__hero-title">Tre Cookware</h1>
          <p class="tg__lede">
            The Essential Collection is our quiet promise: to care for your kitchen, your meals,
            and the moments that matter most, with tools built to endure and made to nurture.
          </p>
          <p class="tg__lede">
            Your cookware is crafted with pure, safe, high quality materials, free from harmful
            additives or coatings.
          </p>
        </div>
        <div>
          <img
            src="{{ 'guide-hero-collection.jpg' | asset_url }}"
            alt="TRE stainless steel cookware set on a range"
            width="1400"
            height="1969"
            loading="eager"
          >
        </div>
      </header>

      {%- comment -%} ── Index ──────────────────────────────────────── {%- endcomment -%}
      <nav class="tg__index" aria-label="Guide contents">
        <h2 class="tg__index-title">Index</h2>
        <ol class="tg__index-list">
          <li><a href="#tg-essential">Only What's Essential</a></li>
          <li><a href="#tg-materials">Materials</a></li>
          <li><a href="#tg-design">Design</a></li>
          <li><a href="#tg-care">Cleaning and Care</a></li>
          <li><a href="#tg-how-to-use">How To Use</a></li>
          <li><a href="#tg-concerns">Common Concerns</a></li>
          <li><a href="#tg-warranty">Tre Warranty</a></li>
        </ol>
      </nav>

      {%- comment -%} ── 1. Only What's Essential ───────────────────── {%- endcomment -%}
      <section class="tg__chapter{{ anim }}" id="tg-essential">
        <div class="tg__chapter-head">
          <span class="tg__num">One</span>
          <h2 class="tg__title">Only What's Essential</h2>
        </div>

        <div class="tg__split tg__split--top">
          <h3 class="tg__sub" style="margin-top: 0;">The Essential Collection.</h3>
          <div class="tg__text">
            <p>
              The foundation of every kitchen begins with the right tools. The Essential Collection
              is a carefully chosen set of cookware, timeless pieces crafted from premium stainless
              steel and designed to meet the rhythm of everyday cooking.
            </p>
            <p>
              Each piece balances versatility with efficiency, giving you the core sizes and
              functions you'll reach for again and again. Thoughtfully curated and beautifully made,
              this is the heart of your kitchen.
            </p>
          </div>
        </div>

        <div class="tg__pieces">
          <div class="tg__piece">
            <div class="tg__piece-art">
              <img src="{{ 'guide-frying-pan-20.png' | asset_url }}" alt="20cm frying pan" width="796" height="244" loading="lazy">
            </div>
            <p class="tg__piece-label">20cm<br>Frying Pan</p>
          </div>
          <div class="tg__piece">
            <div class="tg__piece-art">
              <img src="{{ 'guide-frying-pan-26.png' | asset_url }}" alt="26cm frying pan" width="900" height="233" loading="lazy">
            </div>
            <p class="tg__piece-label">26cm<br>Frying Pan</p>
          </div>
          <div class="tg__piece">
            <div class="tg__piece-art">
              <img src="{{ 'guide-frying-pan-28.png' | asset_url }}" alt="28cm frying pan" width="900" height="232" loading="lazy">
            </div>
            <p class="tg__piece-label">28cm<br>Frying Pan</p>
          </div>
          <div class="tg__piece">
            <div class="tg__piece-art">
              <img src="{{ 'guide-sauce-pan-16.png' | asset_url }}" alt="16cm sauce pan" width="752" height="388" loading="lazy">
            </div>
            <p class="tg__piece-label">16cm<br>Sauce Pan</p>
          </div>
          <div class="tg__piece">
            <div class="tg__piece-art">
              <img src="{{ 'guide-saute-pan-26.png' | asset_url }}" alt="26cm sauté pan" width="900" height="330" loading="lazy">
            </div>
            <p class="tg__piece-label">26cm<br>Sauté Pan</p>
          </div>
          <div class="tg__piece">
            <div class="tg__piece-art">
              <img src="{{ 'guide-stockpot-20.png' | asset_url }}" alt="20cm stockpot" width="736" height="412" loading="lazy">
            </div>
            <p class="tg__piece-label">20cm<br>Stockpot</p>
          </div>
          <div class="tg__piece">
            <div class="tg__piece-art">
              <img src="{{ 'guide-stockpot-26.png' | asset_url }}" alt="26cm stockpot" width="832" height="472" loading="lazy">
            </div>
            <p class="tg__piece-label">26cm<br>Stockpot</p>
          </div>
          <div class="tg__piece">
            <div class="tg__piece-art">
              <img src="{{ 'guide-steamer-26.png' | asset_url }}" alt="26cm steamer" width="836" height="312" loading="lazy">
            </div>
            <p class="tg__piece-label">26cm<br>Steamer</p>
          </div>
        </div>
      </section>

      {%- comment -%} ── 2. Materials ───────────────────────────────── {%- endcomment -%}
      <section class="tg__chapter{{ anim }}" id="tg-materials">
        <div class="tg__chapter-head">
          <span class="tg__num">Two</span>
          <h2 class="tg__title">Materials</h2>
        </div>

        <div class="tg__split">
          <div>
            <h3 class="tg__sub" style="margin-top: 0;">Uncoated Stainless Steel.</h3>
            <div class="tg__text">
              <p>
                Cooking with uncoated stainless steel offers a level of purity and peace of mind
                that coated alternatives, even those labeled "non-toxic", simply can't match.
              </p>
              <p>
                With no synthetic layers or chemical treatments, uncoated steel is naturally inert,
                meaning it won't break down, leach, or react with your food, even at high
                temperatures.
              </p>
              <p>
                Unlike coated pans, which can degrade over time and may contain binders or
                stabilizers with unknown long-term effects, stainless steel remains stable and
                reliable for life.
              </p>
              <p>
                It's a healthier choice, no coatings to chip, no hidden risks, just clean, safe
                cooking, every single time.
              </p>
            </div>
          </div>
          <div>
            <img
              src="{{ 'guide-pan-closeup.jpg' | asset_url }}"
              alt="Close-up of an uncoated stainless steel pan"
              width="1400"
              height="1353"
              loading="lazy"
            >
          </div>
        </div>

        <h3 class="tg__sub">Five Ply Construction</h3>
        <div class="tg__split tg__split--wide-media">
          <div>
            <img
              src="{{ 'guide-five-ply.png' | asset_url }}"
              alt="Cutaway diagram of the five ply construction: 403 stainless steel exterior, three aluminum layers, and an 18/10 stainless steel interior"
              width="1400"
              height="1235"
              loading="lazy"
            >
          </div>
          <div>
            <p class="tg__text" style="margin-bottom: 24px;">The multi-layered structure includes:</p>
            <dl class="tg__layers">
              <div class="tg__layer">
                <dt>18/10 Stainless Steel Interior</dt>
                <dd>A non-reactive, non-corrosive, low-maintenance finish that resists sticking and simplifies cleanup.</dd>
              </div>
              <div class="tg__layer">
                <dt>3 Aluminum Layers</dt>
                <dd>Ensures rapid, even heat diffusion across the surface with precise thermal responsiveness for enhanced temperature control.</dd>
              </div>
              <div class="tg__layer">
                <dt>403 Stainless Steel Exterior</dt>
                <dd>A durable, polished surface, built to look elegant and withstand daily use.</dd>
              </div>
              <div class="tg__layer">
                <dt>1.0mm Lid</dt>
                <dd>Thick stainless steel 1.0 mm lid engineered to seal in moisture and flavor during cooking.</dd>
              </div>
              <div class="tg__layer">
                <dt>Handles</dt>
                <dd>Cast handle built to last for decades.</dd>
              </div>
            </dl>
          </div>
        </div>
      </section>

      {%- comment -%} ── 3. Design ──────────────────────────────────── {%- endcomment -%}
      <section class="tg__chapter{{ anim }}" id="tg-design">
        <div class="tg__chapter-head">
          <span class="tg__num">Three</span>
          <h2 class="tg__title">Design</h2>
        </div>

        <div class="tg__split">
          <div>
            <img
              src="{{ 'guide-saucepan.jpg' | asset_url }}"
              alt="TRE stainless steel sauce pan with lid"
              width="1200"
              height="1020"
              loading="lazy"
            >
          </div>
          <div class="tg__steps">
            <div>
              <h3 class="tg__step-title">Complete Sealed Rims Technology</h3>
              <div class="tg__text">
                <p>
                  Although hand washing is the gold standard when it comes to caring for your
                  beloved cookware, sealed rims are what make cookware truly dishwasher-safe.
                </p>
              </div>
            </div>
            <div>
              <h3 class="tg__step-title">Universal Lid Compatibility</h3>
              <div class="tg__text">
                <p>Thoughtfully designed lids fit multiple TRE pieces, between sauté pans, frypans and stockpots.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="tg__split" style="margin-top: 56px;">
          <div class="tg__steps">
            <div>
              <h3 class="tg__step-title">Comfortable Handle</h3>
              <div class="tg__text">
                <p>Its thoughtful design ensures easy maneuverability, allowing you to stir, pour, and serve with confidence.</p>
              </div>
            </div>
            <div>
              <h3 class="tg__step-title">Sleek, Flared Edges</h3>
              <div class="tg__text">
                <p>For effortless flipping and pouring.</p>
              </div>
            </div>
          </div>
          <div>
            <img
              src="{{ 'guide-frypan.jpg' | asset_url }}"
              alt="TRE stainless steel frying pan"
              width="1200"
              height="645"
              loading="lazy"
            >
          </div>
        </div>
      </section>

      {%- comment -%} ── 4. Cleaning and Care ───────────────────────── {%- endcomment -%}
      <section class="tg__chapter{{ anim }}" id="tg-care">
        <div class="tg__chapter-head">
          <span class="tg__num">Four</span>
          <h2 class="tg__title">Cleaning and Care</h2>
        </div>

        <div class="tg__bleed" style="margin-top: 0;">
          <img
            src="{{ 'guide-care-sink.jpg' | asset_url }}"
            alt="A wooden dish brush resting in a soapy stainless steel pan"
            width="2000"
            height="1116"
            loading="lazy"
          >
        </div>

        <div class="tg__steps tg__steps--two">
          <div>
            <span class="tg__step-num">One</span>
            <h3 class="tg__step-title">Deglaze and Let it Cool</h3>
            <div class="tg__text">
              <p>
                Right after cooking, while the pan is still hot, add a small amount of water to
                deglaze the pan of any stuck or burnt food. This will help make cleaning so much
                easier. Allow the pan to cool naturally before washing.
              </p>
            </div>
          </div>
          <div>
            <span class="tg__step-num">Two</span>
            <h3 class="tg__step-title">Wash</h3>
            <div class="tg__text">
              <p>Use dish soap and a non abrasive sponge or brush to clean the pan.</p>
              <p>
                You can use the dishwasher. Your cookware is dishwasher safe thanks to its sealed
                rims. That being said, hand washing is always best.
              </p>
            </div>
          </div>
          <div>
            <span class="tg__step-num">Three</span>
            <h3 class="tg__step-title">Dry</h3>
            <div class="tg__text">
              <p>Wipe dry with a microfiber towel to reveal the brilliant shine of polished steel.</p>
            </div>
          </div>
          <div>
            <span class="tg__step-num">Four</span>
            <h3 class="tg__step-title">Polish</h3>
            <div class="tg__text">
              <p>
                For cookware stained and dulled from regular use, restore shine with vinegar, baking
                soda, or TRE Treatment Powder for those resistant stains. Apply TRE treatment only
                occasionally as a refresh.
              </p>
            </div>
          </div>
        </div>
      </section>

      {%- comment -%} ── 5. How To Use ──────────────────────────────── {%- endcomment -%}
      <section class="tg__chapter{{ anim }}" id="tg-how-to-use">
        <div class="tg__chapter-head">
          <span class="tg__num">Five</span>
          <h2 class="tg__title">How to Use Your Cookware</h2>
        </div>

        <p class="tg__lede">
          Cooking with stainless steel has a learning curve, but once you master the heat, the
          results are worth it.
        </p>

        <div class="tg__steps tg__steps--two">
          <div>
            <h3 class="tg__step-title">1. Warm it Up First</h3>
            <div class="tg__text">
              <p>Start with low to medium heat. A few water drops should glide when it's ready.</p>
              <p>TRE cookware retains heat beautifully — gentle to medium heat is all you need.</p>
            </div>
          </div>
          <div class="tg__usestep">
            <div>
              <h3 class="tg__step-title">2. Add Oil After Heating</h3>
              <div class="tg__text">
                <p>This creates a natural barrier to help prevent sticking.</p>
              </div>
            </div>
            <div class="tg__usestep-art">
              <img src="{{ 'guide-step-oil.jpg' | asset_url }}" alt="Droplets of cooking oil" width="600" height="594" loading="lazy">
            </div>
          </div>
          <div class="tg__usestep">
            <div>
              <h3 class="tg__step-title">3. Let Food Release Naturally</h3>
              <div class="tg__text">
                <p>Food will release on its own when it's ready, no need to force it.</p>
              </div>
            </div>
            <div class="tg__usestep-art">
              <img src="{{ 'guide-step-egg.jpg' | asset_url }}" alt="A fried egg" width="600" height="598" loading="lazy">
            </div>
          </div>
          <div class="tg__usestep">
            <div>
              <h3 class="tg__step-title">4. Use What You Love</h3>
              <div class="tg__text">
                <p>Metal, wood, or silicone utensils, your cookware can handle it.</p>
              </div>
            </div>
            <div class="tg__usestep-art">
              <img src="{{ 'guide-step-utensils.jpg' | asset_url }}" alt="A wooden spoon and a silicone spatula" width="441" height="924" loading="lazy">
            </div>
          </div>
        </div>
      </section>

      {%- comment -%} ── 6. Common Concerns ─────────────────────────── {%- endcomment -%}
      <section class="tg__chapter{{ anim }}" id="tg-concerns">
        <div class="tg__chapter-head">
          <span class="tg__num">Six</span>
          <h2 class="tg__title">Common Concerns</h2>
        </div>

        <div class="tg__concerns">
          <div class="tg__concern">
            <h3>Discoloration and spots</h3>
            <div class="tg__text">
              <p>
                Overheating an empty pan or leaving it unattended on a flame can cause discoloration.
                This is a natural metal reaction and won't affect performance or safety. If you ever
                miss the shine, use TRE powder to restore the pan's original look.
              </p>
              <p>
                White spots or stains are often caused by minerals in water. A mixture of vinegar and
                water can help dissolve them.
              </p>
            </div>
          </div>
          <div class="tg__concern">
            <h3>Food sticking</h3>
            <div class="tg__text">
              <p>
                Try preheating a bit longer and adding oil after the pan is hot. Let food release
                naturally, it will lift when it's ready.
              </p>
            </div>
          </div>
          <div class="tg__concern">
            <h3>Handles getting hot</h3>
            <div class="tg__text">
              <p>
                TRE handles are stainless steel too, always use a mitt when cooking for longer
                periods or using the oven.
              </p>
            </div>
          </div>
        </div>
      </section>

      {%- comment -%} ── 7. Warranty ────────────────────────────────── {%- endcomment -%}
      <section class="tg__chapter{{ anim }}" id="tg-warranty">
        <div class="tg__chapter-head">
          <span class="tg__num">Seven</span>
          <h2 class="tg__title">Tre Warranty</h2>
        </div>

        <div class="tg__split tg__split--top">
          <div class="tg__text">
            <p>TRE cookware makes healthy eating kind to your body and your budget.</p>
            <p>Backed by a lifetime warranty against manufacturing or craftsmanship issues.</p>
          </div>
          <div class="tg__text">
            <p>
              Warranty claims:<br>
              <a href="mailto:info@trecookware.com">info@trecookware.com</a>
            </p>
          </div>
        </div>

        {%- comment -%} Closing spread {%- endcomment -%}
        <div class="tg__closing">
          <h2 class="tg__closing-title">Good tools cultivate good habits.</h2>
          <div class="tg__split">
            <div class="tg__text">
              <p>
                Thank you for choosing TRE to be part of your kitchen. We look forward to seeing how
                you create delicious meals, one thoughtful dish at a time. Don't forget to share your
                culinary journey with us.
              </p>
            </div>
            <div class="tg__text">
              <p>Bring your recipe to the table and inspire fellow home-chefs in the TRE community.</p>
              <p class="tg__meta">
                <a href="https://trecookware.com">trecookware.com</a><br>
                IG: <a href="https://instagram.com/trecookware" rel="noopener" target="_blank">@trecookware</a>
              </p>
            </div>
          </div>
        </div>
      </section>

    </div>
  </div>
</div>


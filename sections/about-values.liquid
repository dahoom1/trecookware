{% comment %}
  Section: About — Values Columns
  Equal-width columns, each with an icon (SVG preset or custom image), heading and text.
  Repeatable via blocks. Self-contained styles; supports color schemes.
{% endcomment %}

{%- style -%}
  .abv-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .abv-{{ section.id }}__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .abv-{{ section.id }}__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 48px;
  }
  .abv-{{ section.id }}__title {
    margin: 0 0 12px;
    font-family: var(--font-heading-family);
    line-height: 1.2;
  }
  .abv-{{ section.id }}__subtitle {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: var(--t-body);
    line-height: 1.6;
    opacity: 0.8;
  }

  .abv-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
  }

  .abv-{{ section.id }}__item {
    text-align: {{ section.settings.column_alignment }};
  }

  .abv-{{ section.id }}__icon {
    display: {% if section.settings.column_alignment == 'center' %}inline-flex{% else %}flex{% endif %};
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin-bottom: 18px;
    color: rgb(var(--color-foreground));
  }
  .abv-{{ section.id }}__icon svg { width: 100%; height: 100%; }
  .abv-{{ section.id }}__icon img { width: 100%; height: 100%; object-fit: contain; }

  .abv-{{ section.id }}__item-title {
    margin: 0 0 10px;
    font-family: var(--font-heading-family);
    font-size: var(--t-subtitle);
    line-height: 1.3;
  }
  .abv-{{ section.id }}__item-text {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: var(--t-body);
    line-height: 1.65;
    opacity: 0.85;
  }
  .abv-{{ section.id }}__item-text p { margin: 0 0 10px; }
  .abv-{{ section.id }}__item-text p:last-child { margin: 0; }

  @media screen and (min-width: 750px) {
    .abv-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .abv-{{ section.id }}__grid {
      grid-template-columns: repeat({{ section.blocks.size | at_most: 4 }}, 1fr);
      gap: 48px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="abv-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="abv-{{ section.id }}__inner">
      {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
        <div class="abv-{{ section.id }}__header">
          {%- if section.settings.title != blank -%}
            <h2 class="abv-{{ section.id }}__title {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
          {%- endif -%}
          {%- if section.settings.subtitle != blank -%}
            <p class="abv-{{ section.id }}__subtitle">{{ section.settings.subtitle }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="abv-{{ section.id }}__grid">
        {%- for block in section.blocks -%}
          <div class="abv-{{ section.id }}__item" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="abv-{{ section.id }}__icon">
                {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: block.settings.heading }}
              </div>
            {%- elsif block.settings.icon != 'none' -%}
              <div class="abv-{{ section.id }}__icon">
                {{- block.settings.icon | prepend: 'icon-' | append: '.svg' | inline_asset_content -}}
              </div>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              <h3 class="abv-{{ section.id }}__item-title">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="abv-{{ section.id }}__item-text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About — Values",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "What we stand for"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Three promises behind every piece we make."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "column_alignment",
      "label": "Column alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "info": "Uses a built-in theme icon. Overridden by a custom image if set.",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" },
            { "value": "check-mark", "label": "Check" },
            { "value": "serving-dish", "label": "Serving dish" },
            { "value": "fire", "label": "Fire" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "recycle", "label": "Recycle" }
          ],
          "default": "leaf"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom icon image",
          "info": "Optional. Replaces the icon above."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Clean materials"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Food-grade stainless steel and natural materials — nothing that leaches, nothing to worry about.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About — Values",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "icon": "leaf",
            "heading": "Clean materials",
            "text": "<p>Food-grade stainless steel and natural materials — nothing that leaches, nothing to worry about.</p>"
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "star",
            "heading": "Built to last",
            "text": "<p>Crafted to rigorous standards so each piece stays a daily essential for years, not seasons.</p>"
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "check-mark",
            "heading": "Backed by warranty",
            "text": "<p>We stand behind what we make, with a warranty and a commitment to your satisfaction.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

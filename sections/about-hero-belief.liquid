{% comment %}
  Section: About — Hero Belief Banner
  Full-bleed background image with an overlaid brand-belief statement and optional CTA.
  Self-contained styles; uses global font/typography tokens from base.css.
{% endcomment %}

{%- style -%}
  .abh-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.height_mobile }}px;
    display: flex;
    align-items: {% if section.settings.content_position == 'top' %}flex-start{% elsif section.settings.content_position == 'bottom' %}flex-end{% else %}center{% endif %};
    justify-content: {% if section.settings.content_alignment == 'left' %}flex-start{% elsif section.settings.content_alignment == 'right' %}flex-end{% else %}center{% endif %};
    text-align: {{ section.settings.content_alignment }};
    overflow: hidden;
    isolation: isolate;
  }

  .abh-{{ section.id }}__media,
  .abh-{{ section.id }}__media img,
  .abh-{{ section.id }}__media svg,
  .abh-{{ section.id }}__video-wrapper,
  .abh-{{ section.id }}__video-wrapper img,
  .abh-{{ section.id }}__video-wrapper video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  /* Poster stays visible until the background video can play, then fades out */
  .abh-{{ section.id }}__poster {
    transition: opacity 0.4s ease;
  }
  .abh-{{ section.id }}__video-wrapper.is-video-ready .abh-{{ section.id }}__poster {
    opacity: 0;
  }

  .abh-{{ section.id }}__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: -1;
  }

  .abh-{{ section.id }}__content {
    max-width: 760px;
    padding: 48px 24px;
    color: {{ section.settings.text_color | default: '#ffffff' }};
  }

  .abh-{{ section.id }}__subheading {
    display: block;
    margin: 0 0 14px;
    font-family: var(--font-body-family);
    font-size: var(--t-small);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.9;
    color: {{ section.settings.subheading_color | default: '#ffffff' }};
  }

  .abh-{{ section.id }}__heading {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: var(--t-display);
    line-height: 1.15;
    color: {{ section.settings.heading_color | default: '#ffffff' }};
  }

  .abh-{{ section.id }}__text {
    margin: 18px 0 0;
    font-family: var(--font-body-family);
    font-size: var(--t-body);
    line-height: 1.6;
    opacity: 0.95;
    color: {{ section.settings.text_color | default: '#ffffff' }};
  }
  .abh-{{ section.id }}__text p { margin: 0 0 8px; }
  .abh-{{ section.id }}__text p:last-child { margin: 0; }

  .abh-{{ section.id }}__cta {
    display: inline-block;
    margin-top: 28px;
    padding: 14px 34px;
    font-family: var(--font-body-family);
    font-size: var(--t-body);
    text-decoration: none;
    background: {{ section.settings.button_bg | default: '#ffffff' }};
    color: {{ section.settings.button_text_color | default: '#1a1a1a' }};
    border: 1px solid {{ section.settings.button_bg | default: '#ffffff' }};
    transition: opacity 0.25s ease;
  }
  .abh-{{ section.id }}__cta:hover { opacity: 0.85; }

  @media screen and (min-width: 750px) {
    .abh-{{ section.id }} { min-height: {{ section.settings.height_desktop }}px; }
    .abh-{{ section.id }}__content { padding: 64px 60px; }
  }
{%- endstyle -%}

<div class="abh-{{ section.id }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
  <div class="abh-{{ section.id }}__media">
    {%- liquid
      assign poster = section.settings.image
      if poster == blank and section.settings.video != blank
        assign poster = section.settings.video.preview_image
      endif
      assign poster_class = 'abh-' | append: section.id | append: '__poster'
    -%}
    {%- if section.settings.video != blank -%}
      <div class="abh-{{ section.id }}__video-wrapper" data-hero-video-wrapper>
        {%- comment -%} Poster loads eagerly for a fast first paint (hero LCP); video streams in after. {%- endcomment -%}
        {%- if poster != blank -%}
          {{ poster | image_url: width: 3000 | image_tag:
            class: poster_class,
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '750, 1100, 1500, 2200, 3000',
            alt: ''
          }}
        {%- endif -%}
        {%- comment -%} Deferred until near the viewport to keep it off the critical path. {%- endcomment -%}
        <template data-hero-video-template>
          {{ section.settings.video | video_tag:
            autoplay: true,
            loop: section.settings.video_loop,
            muted: true,
            controls: false,
            playsinline: true,
            image_size: '1920x'
          }}
        </template>
      </div>
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 3000 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1500, 2200, 3000', alt: '' }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  <div class="abh-{{ section.id }}__overlay"></div>

  <div class="abh-{{ section.id }}__content">
    {%- if section.settings.subheading != blank -%}
      <span class="abh-{{ section.id }}__subheading">{{ section.settings.subheading }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="abh-{{ section.id }}__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="abh-{{ section.id }}__text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.show_button and section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="abh-{{ section.id }}__cta">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.video != blank -%}
  <script>
    (function () {
      var wrapper = document.currentScript.parentElement.querySelector('[data-hero-video-wrapper]');
      if (!wrapper) return;

      // Respect users who prefer reduced motion — keep the still poster, skip the video.
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var template = wrapper.querySelector('[data-hero-video-template]');
      if (!template) return;
      var loaded = false;

      function loadVideo() {
        if (loaded) return;
        loaded = true;

        var clone = template.content.cloneNode(true);
        var video = clone.querySelector('video');
        if (video) {
          video.setAttribute('playsinline', '');
          video.setAttribute('webkit-playsinline', '');
          video.muted = true;
          video.setAttribute('preload', 'auto');
          video.addEventListener('playing', function () {
            wrapper.classList.add('is-video-ready');
          }, { once: true });
        }
        template.parentNode.insertBefore(clone, template);
        template.remove();

        var inserted = wrapper.querySelector('video');
        if (inserted) {
          var p = inserted.play();
          if (p && typeof p.catch === 'function') {
            p.catch(function () {
              inserted.addEventListener('canplay', function () {
                var r = inserted.play();
                if (r && typeof r.catch === 'function') r.catch(function () {});
              }, { once: true });
            });
          }
        }
      }

      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries, observer) {
          if (entries.some(function (e) { return e.isIntersecting; })) {
            loadVideo();
            observer.disconnect();
          }
        }, { rootMargin: '200px' });
        io.observe(wrapper);
      } else {
        loadVideo();
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "About — Hero Belief",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Background media"
    },
    {
      "type": "paragraph",
      "content": "Add an image, a video, or both. If a video is set it plays as a muted, looping background and the image is used as its poster/fallback."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video",
      "info": "Optional. A Shopify-hosted video works best. Overrides the image when set."
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "Loop video",
      "default": true
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (eyebrow)",
      "default": "OUR PHILOSOPHY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We believe good cookware should last a lifetime"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Clean materials, honest craftsmanship, and prices that respect your home — the essentials your kitchen truly deserves.</p>"
    },
    {
      "type": "header",
      "content": "Text colors"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content vertical position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 35
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 300,
      "max": 700,
      "step": 20,
      "unit": "px",
      "label": "Height (mobile)",
      "default": 460
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Height (desktop)",
      "default": 620
    }
  ],
  "presets": [
    { "name": "About — Hero Belief" }
  ]
}
{% endschema %}

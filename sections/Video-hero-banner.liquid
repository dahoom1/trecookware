{% comment %}
  Section: Hero Video Banner
  Version 2.0: Now uses global fonts from base.css
  Description: Full-width hero banner with video background, heading, and CTA button
  Separate mobile and desktop content with independent controls
{% endcomment %}

{% style %}
/* Hero Video Banner — overlay layout: full-bleed media with content sitting on top */

.hero-video-banner {
  position: relative;
  width: 100%;
  min-height: {{ section.settings.min_height_mobile }}px;
  display: flex;
  overflow: hidden;
  isolation: isolate;
}

/* === MEDIA (fills the whole frame) === */
.hero-video-banner__media {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.hero-video-banner__video-wrapper {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-video-banner__video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Lazy-load poster: stays visible until the real video can play */
.hero-video-banner__video--poster {
  position: absolute;
  inset: 0;
  transition: opacity 0.3s ease;
}
.hero-video-banner__video-wrapper.is-video-ready .hero-video-banner__video--poster {
  opacity: 0;
}

/* Gradient scrim — fades up from the bottom so text stays legible over the video */
.hero-video-banner__scrim {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.80) 0%,
    rgba(0, 0, 0, 0.45) 28%,
    rgba(0, 0, 0, 0.12) 55%,
    rgba(0, 0, 0, 0) 100%
  );
}

/* Optional flat colour overlay (from settings) */
.hero-video-banner__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
}

/* === CONTENT (overlaid, mobile-first) === */
.hero-video-banner__content {
  position: relative;
  z-index: 2;
  flex: 1 1 auto;
  width: 100%;
  display: flex;
  box-sizing: border-box;
  align-items: {{ section.settings.content_alignment_vertical_mobile | default: 'flex-end' }};
  justify-content: {{ section.settings.content_alignment_horizontal_mobile | default: 'flex-start' }};
  padding: {{ section.settings.padding_top_mobile | default: 60 }}px {{ section.settings.padding_horizontal_mobile | default: 24 }}px {{ section.settings.padding_bottom_mobile | default: 56 }}px;
}

{%- comment -%} Logical alignment so it auto-mirrors in RTL (Arabic): left→start, right→end {%- endcomment -%}
{% assign ta_m_raw = section.settings.text_alignment_mobile | default: 'left' %}
{% if ta_m_raw == 'left' %}{% assign ta_m_logical = 'start' %}{% elsif ta_m_raw == 'right' %}{% assign ta_m_logical = 'end' %}{% else %}{% assign ta_m_logical = 'center' %}{% endif %}
.hero-video-banner__content-inner {
  width: 100%;
  max-width: {{ section.settings.content_max_width | default: 800 }}px;
  text-align: {{ ta_m_logical }};
}

/* === HEADING === */
.hero-video-banner__mobile-heading {
  margin: 0 0 {{ section.settings.mobile_heading_margin_bottom | default: 16 }}px;
  font-family: var(--font-heading-family);
  font-weight: {{ section.settings.heading_font_weight }};
  font-size: clamp(32px, 8.5vw, 44px);
  line-height: 1.04;
  letter-spacing: -0.01em;
  text-wrap: balance;
  color: {{ section.settings.mobile_heading_color | default: section.settings.heading_color | default: '#FFFFFF' }};
  text-shadow: 0 1px 24px rgba(0, 0, 0, 0.22);
}

/* === SUBHEADING === */
.hero-video-banner__mobile-subheading {
  margin: 0 0 {{ section.settings.mobile_subheading_margin_bottom | default: 28 }}px;
  font-family: var(--font-body-family);
  font-weight: {{ section.settings.subheading_font_weight }};
  font-size: 15px;
  line-height: 1.6;
  color: {{ section.settings.mobile_subheading_color | default: '#FFFFFF' }};
  opacity: 0.92;
}

/* === BUTTONS === */
{% assign btn_dir = section.settings.button_layout | default: 'row' %}
{% assign ta_m = section.settings.text_alignment_mobile | default: 'left' %}
{% if ta_m == 'center' %}{% assign align_m = 'center' %}{% elsif ta_m == 'right' %}{% assign align_m = 'flex-end' %}{% else %}{% assign align_m = 'flex-start' %}{% endif %}
.hero-video-banner__mobile-button-wrapper {
  display: flex;
  flex-direction: {{ btn_dir }};
  gap: 18px;
  flex-wrap: {% if btn_dir == 'column' %}nowrap{% else %}wrap{% endif %};
  margin-top: 4px;
  {% if btn_dir == 'column' %}
  align-items: {{ align_m }};
  {% else %}
  align-items: center;
  justify-content: {{ align_m }};
  {% endif %}
}

.hero-video-banner__mobile-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  padding: {{ section.settings.mobile_button_padding_vertical | default: 15 }}px {{ section.settings.mobile_button_padding_horizontal | default: 34 }}px;
  font-family: var(--font-body-family);
  font-size: var(--t-small);
  font-weight: {{ section.settings.button_font_weight }};
  line-height: 1;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-decoration: none;
  white-space: nowrap;
  border-radius: {{ section.settings.button_border_radius }}px;
  transition: transform 0.25s ease, background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, opacity 0.25s ease;
  cursor: pointer;
}

.hero-video-banner__mobile-button--primary {
  background-color: {{ section.settings.mobile_button_bg_color | default: '#FFFFFF' }};
  color: {{ section.settings.mobile_button_text_color | default: '#1a1a1a' }};
  border: {{ section.settings.button_border_width }}px solid {{ section.settings.mobile_button_border_color | default: '#FFFFFF' }};
}
.hero-video-banner__mobile-button--primary:hover {
  transform: translateY(-2px);
  background-color: {{ section.settings.mobile_button_bg_color_hover | default: '#f1ece5' }};
  color: {{ section.settings.mobile_button_text_color_hover | default: '#1a1a1a' }};
  border-color: {{ section.settings.mobile_button_border_color_hover | default: '#f1ece5' }};
}

.hero-video-banner__mobile-button--secondary {
  background-color: {{ section.settings.mobile_button_secondary_bg_color | default: 'rgba(0,0,0,0)' }};
  color: {{ section.settings.mobile_button_secondary_text_color | default: '#FFFFFF' }};
  border: {{ section.settings.button_border_width | default: 1 }}px solid {{ section.settings.mobile_button_secondary_border_color | default: 'rgba(255,255,255,0.55)' }};
}
.hero-video-banner__mobile-button--secondary:hover {
  transform: translateY(-2px);
  background-color: {{ section.settings.mobile_button_secondary_bg_color_hover | default: '#FFFFFF' }};
  color: {{ section.settings.mobile_button_secondary_text_color_hover | default: '#1a1a1a' }};
  border-color: {{ section.settings.mobile_button_secondary_border_color_hover | default: '#FFFFFF' }};
}

/* Animated arrow on the secondary CTA (matches the reference design) */
{% if section.settings.secondary_button_arrow %}
.hero-video-banner__mobile-button--secondary {
  gap: 8px;
}
/* Arrow points the reading-forward direction and nudges gently ~3px */
.hero-video-banner__mobile-button--secondary::after {
  content: '\2192'; /* → */
  display: inline-block;
  line-height: 1;
  animation: hero-arrow-nudge 1.6s ease-in-out infinite;
}
@keyframes hero-arrow-nudge {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(3px); }
}

/* RTL (Arabic): forward direction is leftward, so flip the glyph and the nudge */
[dir="rtl"] .hero-video-banner__mobile-button--secondary::after {
  content: '\2190'; /* ← */
  animation-name: hero-arrow-nudge-rtl;
}
@keyframes hero-arrow-nudge-rtl {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(-3px); }
}

/* Respect users who prefer less motion — hold the arrow still */
@media (prefers-reduced-motion: reduce) {
  .hero-video-banner__mobile-button--secondary::after {
    animation: none;
  }
}
{% endif %}

/* === DESKTOP (750px and above) === */
@media screen and (min-width: 750px) {
  .hero-video-banner {
    min-height: {{ section.settings.min_height_desktop }}px;
  }

  .hero-video-banner__content {
    align-items: {{ section.settings.content_alignment_vertical_desktop | default: 'flex-end' }};
    justify-content: {{ section.settings.content_alignment_horizontal_desktop | default: 'flex-start' }};
    padding: {{ section.settings.padding_top_desktop | default: 80 }}px {{ section.settings.padding_horizontal_desktop | default: 64 }}px {{ section.settings.padding_bottom_desktop | default: 72 }}px;
  }

  {% assign ta_d = section.settings.text_alignment_desktop | default: 'left' %}
  {% if ta_d == 'left' %}{% assign ta_d_logical = 'start' %}{% elsif ta_d == 'right' %}{% assign ta_d_logical = 'end' %}{% else %}{% assign ta_d_logical = 'center' %}{% endif %}
  .hero-video-banner__content-inner {
    text-align: {{ ta_d_logical }};
  }

  .hero-video-banner__mobile-heading {
    font-size: clamp(40px, 5vw, 66px);
    line-height: 1.02;
  }

  .hero-video-banner__mobile-subheading {
    font-size: var(--t-subtitle);
    max-width: 48ch;
    {% if ta_d == 'center' %}margin-inline: auto;{% elsif ta_d == 'right' %}margin-inline-start: auto;{% endif %}
  }

  {% if ta_d == 'center' %}{% assign align_d = 'center' %}{% elsif ta_d == 'right' %}{% assign align_d = 'flex-end' %}{% else %}{% assign align_d = 'flex-start' %}{% endif %}
  .hero-video-banner__mobile-button-wrapper {
    gap: {% if btn_dir == 'column' %}14px{% else %}22px{% endif %};
    {% if btn_dir == 'column' %}
    align-items: {{ align_d }};
    {% else %}
    align-items: center;
    justify-content: {{ align_d }};
    {% endif %}
  }
}

/* Focus states for accessibility */
.hero-video-banner__mobile-button:focus-visible {
  outline: 2px solid #ffffff;
  outline-offset: 4px;
}

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {
  .hero-video-banner__mobile-button {
    transition: none;
  }
}
{% endstyle %}

{%- comment -%} Resolve content from the mobile_* fields, falling back to the desktop-named fields {%- endcomment -%}
{%- assign hero_heading = section.settings.mobile_heading | default: section.settings.heading -%}
{%- assign hero_subheading = section.settings.mobile_subheading | default: section.settings.subheading -%}
{%- assign hero_btn_text = section.settings.mobile_button_text -%}
{%- assign hero_btn_link = section.settings.mobile_button_link -%}
{%- assign hero_btn2_text = section.settings.mobile_button_secondary_text -%}
{%- assign hero_btn2_link = section.settings.mobile_button_secondary_link -%}
{%- assign hero_poster = section.settings.video_poster | default: section.settings.video_shopify.preview_image -%}

{%- if section.settings.video_shopify != blank and section.settings.video_lazy_load == false -%}
  {%- assign _hero_src = section.settings.video_shopify.sources | where: 'format', 'mp4' | first -%}
  {%- unless _hero_src -%}{%- assign _hero_src = section.settings.video_shopify.sources | first -%}{%- endunless -%}
  {%- if _hero_src -%}
    <link rel="preload" as="video" href="{{ _hero_src.url }}" type="{{ _hero_src.mime_type }}">
  {%- endif -%}
{%- endif -%}

<div class="hero-video-banner">

  <!-- Full-bleed media -->
  <div class="hero-video-banner__media">
    {%- if section.settings.video_shopify != blank -%}
      <div class="hero-video-banner__video-wrapper"{% if section.settings.video_lazy_load %} data-lazy-hero-video{% endif %}>
        {%- if section.settings.video_lazy_load and hero_poster != blank -%}
          {{ hero_poster | image_url: width: 1920 | image_tag:
            class: 'hero-video-banner__video hero-video-banner__video--poster',
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '375, 750, 1100, 1500, 1920',
            alt: ''
          }}
          <template data-hero-video-template>
            {{ section.settings.video_shopify | video_tag:
              autoplay: section.settings.video_autoplay,
              loop: section.settings.video_loop,
              muted: section.settings.video_muted,
              controls: false,
              playsinline: true,
              class: 'hero-video-banner__video',
              image_size: '1920x'
            }}
          </template>
        {%- else -%}
          {{ section.settings.video_shopify | video_tag:
            autoplay: section.settings.video_autoplay,
            loop: section.settings.video_loop,
            muted: section.settings.video_muted,
            controls: false,
            playsinline: true,
            class: 'hero-video-banner__video',
            image_size: '1920x'
          }}
        {%- endif -%}
      </div>
    {%- elsif hero_poster != blank -%}
      {{ hero_poster | image_url: width: 1920 | image_tag:
        class: 'hero-video-banner__video',
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '100vw',
        widths: '375, 750, 1100, 1500, 1920',
        alt: ''
      }}
    {%- endif -%}

    <div class="hero-video-banner__scrim"></div>

    {%- if section.settings.enable_overlay -%}
      <div class="hero-video-banner__overlay" style="background-color: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
    {%- endif -%}
  </div>

  <!-- Overlaid content -->
  <div class="hero-video-banner__content">
    <div class="hero-video-banner__content-inner">
      {%- if hero_heading != blank -%}
        <h2 class="hero-video-banner__mobile-heading">{{ hero_heading }}</h2>
      {%- endif -%}

      {%- if hero_subheading != blank -%}
        <p class="hero-video-banner__mobile-subheading">{{ hero_subheading }}</p>
      {%- endif -%}

      {%- if hero_btn_text != blank or hero_btn2_text != blank -%}
        <div class="hero-video-banner__mobile-button-wrapper">
          {%- if hero_btn_text != blank -%}
            <a href="{{ hero_btn_link }}" class="hero-video-banner__mobile-button hero-video-banner__mobile-button--primary">{{ hero_btn_text }}</a>
          {%- endif -%}
          {%- if hero_btn2_text != blank -%}
            <a href="{{ hero_btn2_link }}" class="hero-video-banner__mobile-button hero-video-banner__mobile-button--secondary">{{ hero_btn2_text }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

</div>

<script>
  (function () {
    function startPlay(v) {
      // Both attributes required: playsinline for iOS 10+, webkit-playsinline for iOS < 10
      v.setAttribute('playsinline', '');
      v.setAttribute('webkit-playsinline', '');

      function tryPlay() {
        if (!v.paused) return;
        var p = v.play();
        if (p && typeof p.catch === 'function') p.catch(function () {});
      }

      tryPlay();
      // Belt-and-suspenders: retry when video has enough data, in case it wasn't ready yet
      if (v.readyState < 3) {
        v.addEventListener('canplay', tryPlay, { once: true });
      }
    }

    // Non-lazy path: video already in DOM
    document.querySelectorAll('.hero-video-banner__video-wrapper:not([data-lazy-hero-video]) video').forEach(function (v) {
      v.setAttribute('preload', 'auto');
      startPlay(v);
    });

    // Lazy path
    var wrappers = document.querySelectorAll('[data-lazy-hero-video]');
    if (!wrappers.length) return;

    function init(wrapper) {
      var template = wrapper.querySelector('template[data-hero-video-template]');
      if (!template) return;

      var loaded = false;
      function loadVideo() {
        if (loaded) return;
        loaded = true;

        var clone = template.content.cloneNode(true);
        var videoEl = clone.querySelector('video');
        if (videoEl) {
          videoEl.setAttribute('preload', 'auto');
          videoEl.setAttribute('playsinline', '');
          videoEl.setAttribute('webkit-playsinline', '');
          videoEl.addEventListener('playing', function () {
            wrapper.classList.add('is-video-ready');
          }, { once: true });
        }
        template.parentNode.insertBefore(clone, template);
        template.remove();

        var inserted = wrapper.querySelector('video');
        if (inserted) startPlay(inserted);
      }

      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries, observer) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) { loadVideo(); observer.disconnect(); }
          });
        }, { rootMargin: '200px' });
        io.observe(wrapper);
      } else {
        loadVideo();
      }
    }

    function startVisible() {
      wrappers.forEach(function (wrapper) {
        var r = wrapper.getBoundingClientRect();
        if (r.top < window.innerHeight && r.bottom > 0) init(wrapper);
      });
    }

    function startOffscreen() {
      wrappers.forEach(function (wrapper) {
        var r = wrapper.getBoundingClientRect();
        if (!(r.top < window.innerHeight && r.bottom > 0)) init(wrapper);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startVisible, { once: true });
    } else {
      startVisible();
    }

    if (document.readyState === 'complete') {
      startOffscreen();
    } else {
      window.addEventListener('load', startOffscreen, { once: true });
    }
  })();
</script>

{% schema %}
{
  "name": "Hero Video Banner v2.0",
  "tag": "section",
  "class": "section-hero-video-banner",
  "settings": [
    {
      "type": "header",
      "content": "Video Settings"
    },
    {
      "type": "video",
      "id": "video_shopify",
      "label": "Shopify Hosted Video",
      "info": "Upload video directly to Shopify for best performance and CDN delivery"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Video Poster Image",
      "info": "Shown before video loads"

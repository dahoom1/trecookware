{% comment %}
  Section: Email Signup (minimal)
  Description: Redesign of Dawn's newsletter section. Copy on the left, a rule-only
               email field with an animated arrow on the right; stacks on mobile.
  Note: Uses the global type scale and font vars from base.css, so Arabic picks up
        --font-arabic-heading-family automatically. Layout is direction-agnostic —
        the grid and flex rows flip under RTL and the arrow mirrors with it.
{% endcomment %}

{%- liquid
  assign heading_font = 'var(--font-body-family)'
  if section.settings.heading_font == 'heading'
    assign heading_font = 'var(--font-heading-family)'
  endif
-%}

<style>
/* ── Email signup — section {{ section.id }} ── */
.email-signup-{{ section.id }} {
  background-color: {{ section.settings.background_color }};
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
}

.email-signup .page-width {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

.es-inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: 28px;
  align-items: center;
}

/* Same kicker the About sections use (t-small / 0.18em / uppercase / 0.7). */
.es-eyebrow {
  display: block;
  margin: 0 0 14px;
  font-family: var(--font-body-family);
  font-size: var(--t-small);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  opacity: 0.7;
  color: {{ section.settings.eyebrow_color }};
}

/* Arabic tracking is forced to normal globally in base.css, so the letterspaced
   kicker only reads as one in Latin - leave it be rather than fight that rule. */

.es-heading {
  margin: 0 0 12px;
  font-family: {{ heading_font }};
  font-size: clamp({{ section.settings.heading_size_mobile }}px, 5vw, {{ section.settings.heading_size_desktop }}px);
  font-weight: {{ section.settings.heading_font_weight }};
  line-height: 1.08;
  letter-spacing: -0.015em;
  color: {{ section.settings.heading_color }};
}

/* base.css only swaps --font-heading-family for Arabic; --font-body-family stays
   AktivGrotesk, which carries no Arabic glyphs and would fall back to Arial. Pin
   the Arabic display face here so the heading matches every other section in ar,
   whichever font the setting picks for Latin. */
html[lang="ar"] .es-heading,
html[lang^="ar-"] .es-heading {
  font-family: var(--font-arabic-heading-family);
}

.es-text {
  margin: 0;
  max-width: 46ch;
  font-family: var(--font-body-family);
  font-size: var(--t-subtitle);
  line-height: 1.55;
  color: {{ section.settings.text_color }};
}

.es-text p { margin: 0; }
.es-text p + p { margin-top: 0.5em; }

/* Rule-only field: no box, just a baseline and an arrow at the far end. */
.es-field {
  display: flex;
  align-items: center;
  gap: 16px;
  border-bottom: 1px solid {{ section.settings.line_color }};
  padding-bottom: 12px;
  transition: border-color 0.2s ease;
}

.es-field:focus-within {
  border-bottom-color: {{ section.settings.heading_color }};
}

.es-input {
  flex: 1 1 auto;
  min-width: 0;
  border: 0;
  background: transparent;
  padding: 0;
  font-family: var(--font-body-family);
  font-size: var(--t-subtitle);
  line-height: 1.4;
  color: {{ section.settings.heading_color }};
}

.es-input:focus {
  outline: none;
}

.es-input::placeholder {
  color: {{ section.settings.placeholder_color }};
  opacity: 1;
}

/* Chrome keeps its own autofill background; repaint it to match the section. */
.es-input:-webkit-autofill,
.es-input:-webkit-autofill:hover,
.es-input:-webkit-autofill:focus {
  -webkit-text-fill-color: {{ section.settings.heading_color }};
  -webkit-box-shadow: 0 0 0 1000px {{ section.settings.background_color }} inset;
  transition: background-color 5000s ease-in-out 0s;
}

.es-submit {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0;
  background: transparent;
  padding: 4px;
  cursor: pointer;
  color: {{ section.settings.arrow_color }};
  font-size: var(--t-subtitle);
  line-height: 1;
  transition: opacity 0.2s ease;
}

/* Same arrow as the hero banner CTA: the → glyph, nudged gently ~3px. */
.es-submit::after {
  content: '\2192'; /* → */
  display: inline-block;
  line-height: 1;
  animation: es-arrow-nudge 1.6s ease-in-out infinite;
}

@keyframes es-arrow-nudge {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(3px); }
}

/* RTL (Arabic): forward direction is leftward, so flip the glyph and the nudge. */
[dir="rtl"] .es-submit::after {
  content: '\2190'; /* ← */
  animation-name: es-arrow-nudge-rtl;
}

@keyframes es-arrow-nudge-rtl {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(-3px); }
}

/* Respect users who prefer less motion — hold the arrow still. */
@media (prefers-reduced-motion: reduce) {
  .es-submit::after {
    animation: none;
  }
}

.es-submit:hover {
  opacity: 0.65;
}

.es-submit:focus-visible {
  outline: 2px solid {{ section.settings.heading_color }};
  outline-offset: 3px;
}

.es-message {
  display: flex;
  align-items: center;
  gap: 6px;
  margin: 10px 0 0;
  font-family: var(--font-body-family);
  font-size: var(--t-small);
  line-height: 1.4;
}

.es-message svg {
  width: 13px;
  height: 13px;
  flex-shrink: 0;
}

.es-message--error { color: #a5292a; }
.es-message--success { color: {{ section.settings.heading_color }}; }

.es-visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

/* Desktop: copy left, field right. `justify-self: end` is logical, so RTL
   mirrors the whole arrangement without a second rule. */
@media screen and (min-width: 750px) {
  .email-signup-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .email-signup .page-width {
    max-width: var(--page-width);
    padding: 0 40px;
  }

  /* A sized track rather than `auto`: the input carries min-width: 0 so an
     auto track would size to its min-content and collapse the field. */
  .es-inner {
    grid-template-columns: 1fr minmax(0, {{ section.settings.form_width }}px);
    gap: 60px;
  }

  .es-form-wrap {
    width: 100%;
  }

  .es-heading { margin-bottom: 14px; }
}

@media screen and (min-width: 990px) {
  .email-signup .page-width { padding: 0 60px; }
}

@media screen and (min-width: 1440px) {
  .email-signup .page-width { padding: 0 80px; }
}

.es-heading,
.es-text,
.es-input {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
</style>

<div class="email-signup email-signup-{{ section.id }}">
  <div class="page-width">
    <div class="es-inner">
      <div class="es-copy">
        {%- if section.settings.eyebrow != blank -%}
          <span class="es-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="es-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="es-text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      <div class="es-form-wrap">
        {%- form 'customer', class: 'es-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          <div class="es-field">
            <label class="es-visually-hidden" for="EmailSignup--{{ section.id }}">
              {{ section.settings.placeholder | escape }}
            </label>
            <input
              id="EmailSignup--{{ section.id }}"
              class="es-input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ section.settings.placeholder | escape }}"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              aria-required="true"
              required
              {%- if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="EmailSignup-error--{{ section.id }}"
              {%- elsif form.posted_successfully? %}
                aria-describedby="EmailSignup-success--{{ section.id }}"
              {%- endif %}
            >
            <button
              type="submit"
              class="es-submit"
              name="commit"
              aria-label="{{ 'newsletter.button_label' | t }}"
            ></button>
          </div>

          {%- if form.errors -%}
            <small class="es-message es-message--error" id="EmailSignup-error--{{ section.id }}">
              {{- 'icon-error.svg' | inline_asset_content -}}
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </small>
          {%- endif -%}

          {%- if form.posted_successfully? -%}
            <p
              class="es-message es-message--success"
              id="EmailSignup-success--{{ section.id }}"
              tabindex="-1"
              autofocus
            >
              {{- 'icon-success.svg' | inline_asset_content -}}
              {{- 'newsletter.success' | t }}
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Email signup (minimal)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Newsletter",
      "info": "Small uppercase kicker above the heading. Leave blank to hide."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Cook Like the Pros"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Trusted by over 1 million home cooks who value safe, professional-grade cookware. Join the movement.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Field placeholder",
      "default": "Enter your email"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        { "value": "body", "label": "Body font (grotesque)" },
        { "value": "heading", "label": "Heading font" }
      ],
      "default": "body",
      "info": "Arabic swaps to the Arabic display face automatically."
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading weight",
      "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Normal (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi Bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading size (mobile)",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 28,
      "max": 90,
      "step": 2,
      "unit": "px",
      "label": "Heading size (desktop)",
      "default": 56
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "form_width",
      "min": 280,
      "max": 640,
      "step": 20,
      "unit": "px",
      "label": "Field width (desktop)",
      "default": 480
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F4F4F2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading and input text",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#3D3D3D"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder",
      "default": "#8A8A85"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Field underline",
      "default": "#B8B8B2"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow",
      "default": "#1A1A1A"
    }
  ],
  "presets": [
    {
      "name": "Email signup (minimal)"
    }
  ]
}
{% endschema %}

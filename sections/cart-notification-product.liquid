{%- comment -%}
  Product row for the added-to-cart pop-down (snippets/cart-notification.liquid).
  One block per line item; cart-notification.js picks the block for the key the
  add returned and moves its contents into the pop-down.
{%- endcomment -%}
{%- if cart != empty -%}
  {%- for item in cart.items -%}
    <div id="cart-notification-product-{{ item.key }}" class="cart-item">
      <div class="cart-notification-product__image">
        {%- if item.image -%}
          <img
            src="{{ item.image | image_url: width: 120 }}"
            alt="{{ item.image.alt | escape }}"
            width="56"
            height="{{ 56 | divided_by: item.image.aspect_ratio | ceil }}"
            loading="lazy"
          >
        {%- endif -%}
      </div>
      <div class="cart-notification-product__info">
        <p class="cart-notification-product__label">{{ 'general.cart.added_to_cart' | t }}</p>
        <p class="cart-notification-product__name">{{ item.product.title | escape }}</p>
        <p class="cart-notification-product__price">{{ item.final_price | money }}</p>
      </div>
    </div>
  {%- endfor -%}
{%- endif -%}

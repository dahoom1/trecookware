{% comment %}
  Renders cart drawer with Upsells, Progress Bar and Smart Conversion features
  Version 2.0: Added RTL support for Arabic
  Version 3.0: Flat white panel with a pinned footer (cart drawer test branch)
  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<style>
  /* ===========================
     TRE CART DRAWER
     One white panel in three bands: a header, a scrolling body (free-shipping
     banner, column heads, line items) and a pinned footer (totals, checkout,
     trust marks, payment logos). Every rule is #CartDrawer-scoped so the tokens
     and overrides cannot leak into the rest of the theme, and so they outrank
     Dawn's `.cart-drawer ...` rules without !important.

     Sizes are in px on purpose: Dawn sets the root font-size to 62.5%, so rem
     values here would read 10px-based and drift from the design.
  =========================== */
  #CartDrawer {
    --tre-forest: #084a32;
    --tre-terracotta: #c04001;
    --tre-terracotta-hover: #a33600;
    --tre-soft-bg: #f7f7f7;
    --tre-hairline: #f3f4f6;
    --tre-ink: #111827;
    --tre-ink-soft: #1f2937;
    --tre-muted: #6b7280;
    --tre-faint: #9ca3af;
    --tre-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --tre-gutter: 20px;
    /* A barely-there 2px on every corner: square like the rest of the theme,
       without the knife edge of a true 0. One value changes them all. */
    --tre-radius: 2px;
  }

  @media screen and (min-width: 640px) {
    #CartDrawer {
      --tre-gutter: 24px;
    }
  }

  /* ===========================
     OPEN / CLOSE MOTION
     The scrim lives on the overlay child rather than on .drawer so it can fade
     on its own opacity. Left on .drawer it could only follow `visibility`,
     which has no intermediate state, and the dark layer landed in one frame
     while the panel was still sliding.
  =========================== */
  .drawer {
    visibility: hidden;
    position: fixed;
    inset: 0;
    background-color: transparent;
    transition: visibility 0.38s ease;
  }

  .drawer .cart-drawer__overlay {
    background-color: rgba(0, 0, 0, 0.4);
    opacity: 0;
    transition: opacity 0.35s ease-in-out;
  }

  .drawer.active .cart-drawer__overlay {
    opacity: 1;
  }

  /* A fast start that settles gently. will-change keeps the panel on its own
     compositor layer for the slide. */
  .drawer .drawer__inner {
    transition: transform 0.38s var(--tre-ease-out, cubic-bezier(0.16, 1, 0.3, 1));
    will-change: transform;
  }

  @keyframes cart-item-in {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes cart-panel-in {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Gated behind .is-opening, which cart-drawer.js adds on open and drops once
     the sequence has played. The resting state is the finished state, so a
     re-render after a quantity change never replays this, and dropping the
     class mid-flight leaves everything visible rather than half-faded.
     `backwards` holds each row at its from-state through its own delay.
     Keep CartDrawer.OPENING_SEQUENCE_MS in step with the last delay here. */
  .drawer.is-opening .cart-items__body .cart-item {
    animation: cart-item-in 0.4s var(--tre-ease-out) backwards;
  }

  .drawer.is-opening .cart-items__body .cart-item:nth-child(1) { animation-delay: 0.12s; }
  .drawer.is-opening .cart-items__body .cart-item:nth-child(2) { animation-delay: 0.18s; }
  .drawer.is-opening .cart-items__body .cart-item:nth-child(3) { animation-delay: 0.24s; }
  .drawer.is-opening .cart-items__body .cart-item:nth-child(4) { animation-delay: 0.30s; }
  .drawer.is-opening .cart-items__body .cart-item:nth-child(5) { animation-delay: 0.36s; }
  /* Everything past the fifth row shares the last delay, so a long cart does
     not keep ramping until the tail arrives a second late. */
  .drawer.is-opening .cart-items__body .cart-item:nth-child(n+6) { animation-delay: 0.42s; }

  /* The empty state has no list to stagger, so it settles in as one piece. */
  .drawer.is-opening .drawer__inner-empty {
    animation: cart-panel-in 0.4s var(--tre-ease-out) 0.12s backwards;
  }

  /* A removed row lifts and fades while the cart round-trip is in flight; the
     re-render then takes it out for good. cart-drawer.js adds the class on
     click and clears it again if the removal fails. */
  #CartDrawer .cart-item {
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  #CartDrawer .cart-item.is-removing {
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer .drawer__inner,
    .drawer .cart-drawer__overlay,
    #CartDrawer .cart-item,
    #CartDrawer .shipping-progress-fill {
      transition-duration: 0.01ms;
    }

    .drawer.is-opening .cart-items__body .cart-item,
    .drawer.is-opening .drawer__inner-empty {
      animation: none;
    }
  }

  /* ===========================
     PANEL
  =========================== */
  /* Panel height follows the *visible* viewport. `height: 100%` on a fixed
     element resolves against the large viewport on iOS Safari - the height it
     would have with the URL bar collapsed - so while the bar is expanded the
     bottom of the panel sits below the fold, taking the checkout CTA with it.
     `dvh` tracks the bar as it shows and hides. `100%` is the fallback. */
  cart-drawer.drawer {
    height: 100%;
    height: 100dvh;
  }

  /* .drawer__inner carries the theme's `gradient color-{scheme}` classes, so
     this needs the #CartDrawer prefix to outrank them. Full width on phones,
     a 448px sheet from there up. */
  #CartDrawer .drawer__inner {
    width: 448px;
    max-width: 100vw;
    padding: 0;
    border: 0;
    background: #fff;
    color: var(--tre-ink);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  /* ===========================
     HEADER
  =========================== */
  /* Sticky so the close button stays on screen when the whole panel becomes
     the scroller - component-cart-drawer.css does that below 650px of
     viewport height, and at full phone width there is no overlay strip left
     to tap instead. */
  #CartDrawer .drawer__header {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 0;
    padding: var(--tre-gutter) var(--tre-gutter) 16px;
    background: #fff;
    border-bottom: 1px solid var(--tre-hairline);
  }

  #CartDrawer .drawer__heading {
    flex: 1;
    min-width: 0;
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 24px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: normal;
    color: var(--tre-ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* In the header the close button sits in the flex row beside the title
     instead of floating over it, so it never needs space reserved for it. */
  #CartDrawer .drawer__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    min-width: 0;
    min-height: 0;
    padding: 8px;
    border-radius: var(--tre-radius);
    color: var(--tre-faint);
    box-shadow: none;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  #CartDrawer .drawer__close:hover {
    color: #374151;
    background-color: var(--tre-hairline);
  }

  #CartDrawer .drawer__close .svg-wrapper {
    width: 14px;
    height: 14px;
  }

  #CartDrawer .drawer__header .drawer__close {
    position: static;
  }

  /* Empty cart: Dawn hides the header and footer with (0,2,1) selectors, which
     the ID-scoped display rules in this block outrank, so the hiding is
     restated here at matching strength. The empty-state block then owns the
     panel, with its own close button in the corner. */
  cart-drawer.is-empty #CartDrawer .drawer__header,
  #CartDrawer cart-drawer-items.is-empty + .drawer__footer {
    display: none;
  }

  #CartDrawer cart-drawer-items.is-empty {
    padding: 0;
  }

  /* The empty state has no header row, so its close button stays pinned to
     the panel corner. */
  #CartDrawer .cart-drawer__warnings .drawer__close {
    position: absolute;
    top: 16px;
    right: 16px;
  }

  [dir="rtl"] #CartDrawer .cart-drawer__warnings .drawer__close {
    right: auto;
    left: 16px;
  }

  /* ===========================
     FREE-SHIPPING BANNER
     Restyles snippets/progress-bar-v2.liquid inside the drawer only. The
     snippet keeps its own markup, script and threshold.
  =========================== */
  #CartDrawer .shipping-progress-wrapper {
    width: auto;
    margin: var(--tre-gutter) var(--tre-gutter) 0;
    padding: 14px;
    text-align: center;
    background: linear-gradient(to right, #f0f9ff, #eff6ff);
    border: 1px solid rgba(224, 242, 254, 0.8);
    border-radius: var(--tre-radius);
  }

  /* A white track with a hairline edge: the pale fill would disappear into a
     tinted track on the banner's light-blue ground. */
  #CartDrawer .shipping-progress-bar {
    height: 8px;
    margin-bottom: 10px;
    border-radius: var(--tre-radius);
    background: #fff;
    box-shadow: inset 0 0 0 1px rgba(192, 221, 233, 0.6);
  }

  /* Long and front-loaded, so the fill is seen travelling: from empty each
     time the drawer opens (cart-drawer.js replayShippingBar), and from its old
     level to the new one when the cart changes with the drawer open
     (progress-bar-v2's observer). */
  #CartDrawer .shipping-progress-fill {
    border-radius: var(--tre-radius);
    background: #c0dde9;
    transition: width 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  #CartDrawer .shipping-progress-shine {
    display: none;
  }

  /* The snippet colours its unlocked message with !important, so matching it
     is the only way to bring both states onto one green. */
  #CartDrawer .shipping-progress-text p,
  #CartDrawer .shipping-progress-text .success-text {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.4;
    color: #059669 !important;
  }

  #CartDrawer .shipping-progress-text strong {
    font-weight: 700;
    color: inherit;
  }

  @media screen and (min-width: 640px) {
    #CartDrawer .shipping-progress-text p,
    #CartDrawer .shipping-progress-text .success-text {
      font-size: 14px;
    }
  }

  /* ===========================
     SCROLLING BODY
  =========================== */
  #CartDrawer cart-drawer-items {
    padding: var(--tre-gutter);
    background: #fff;
  }

  /* Firefox only. Chromium 121+ drops all ::-webkit-scrollbar styling on an
     element that sets either standard property, so they must not reach it. */
  @supports not selector(::-webkit-scrollbar) {
    #CartDrawer cart-drawer-items {
      scrollbar-width: thin;
      scrollbar-color: #ccc #f1f1f1;
    }
  }

  #CartDrawer cart-drawer-items::-webkit-scrollbar {
    width: 4px;
  }

  #CartDrawer cart-drawer-items::-webkit-scrollbar-track {
    background: #f1f1f1;
  }

  #CartDrawer cart-drawer-items::-webkit-scrollbar-track-piece {
    margin-top: 0;
  }

  #CartDrawer cart-drawer-items::-webkit-scrollbar-thumb {
    background: #ccc;
    border-radius: var(--tre-radius);
  }

  #CartDrawer cart-drawer-items::-webkit-scrollbar-thumb:hover {
    background: #aaa;
  }

  /* Column heads: a quiet label row, not a table header. */
  #CartDrawer .cart-items__header {
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding: 0 0 8px;
    border-bottom: 1px solid var(--tre-hairline);
    font-family: var(--font-body-family);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--tre-faint);
  }

  #CartDrawer .cart-items__header-row {
    display: contents;
  }

  #CartDrawer .cart-items__header-cell {
    width: auto;
    padding: 0;
    border: 0;
    opacity: 1;
    font: inherit;
    letter-spacing: inherit;
    text-align: start;
  }

  #CartDrawer .cart-items__header-cell:last-child {
    text-align: end;
  }

  /* ===========================
     LINE ITEMS
     [ photo ] [ title          | line total ]
     [       ] [ stepper  remove             ]
  =========================== */
  #CartDrawer .cart-items__body {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-top: 20px;
  }

  #CartDrawer .cart-item {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr) auto;
    grid-template-rows: auto 1fr;
    column-gap: 16px;
    row-gap: 12px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  /* The media cell is excluded: this selector is (1,1,1) and would otherwise
     beat the tile's own padding below. */
  #CartDrawer .cart-item > td:not(.cart-item__media) {
    padding: 0;
  }

  /* A square tile on the soft ground, with the product contained inside it so
     every photo sits at the same size down the list whatever its ratio. */
  #CartDrawer .cart-item__media {
    grid-column: 1;
    grid-row: 1 / 3;
    align-self: start;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 80px;
    height: 80px;
    padding: 8px;
    overflow: hidden;
    background: var(--tre-soft-bg);
    border: 1px solid var(--tre-hairline);
    border-radius: var(--tre-radius);
  }

  #CartDrawer .cart-item__media img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
    border-radius: var(--tre-radius);
  }

  /* Bundle child lines: a smaller tile pushed to the end of its column, and a
     tighter gap to the parent, so they read as part of the line above rather
     than as products of their own. */
  #CartDrawer .cart-item__nested-line .cart-item__media {
    justify-self: end;
    width: 56px;
    height: 56px;
    padding: 4px;
  }

  #CartDrawer .cart-items__body .cart-item__nested-line {
    margin-top: -12px;
  }

  /* No flex gap: the details cell always renders an empty discounts list, and
     a <dl> whose options are hidden, and a gap would add their spacing anyway
     and push the stepper down. They are taken out of the flow instead. */
  #CartDrawer .cart-item__details {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    gap: 0;
    min-width: 0;
  }

  #CartDrawer .cart-item__details > * + * {
    margin-top: 0;
  }

  #CartDrawer .cart-item__details > dl,
  #CartDrawer .cart-item__details > .discounts:empty {
    display: none;
  }

  #CartDrawer .cart-item__name {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: normal;
    color: var(--tre-ink);
    text-decoration: none;
  }

  #CartDrawer .cart-item__totals {
    grid-column: 3;
    grid-row: 1;
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    font-family: var(--font-body-family);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--tre-ink);
    text-align: end;
    white-space: nowrap;
  }

  #CartDrawer .cart-item__totals .price {
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    letter-spacing: normal;
    color: inherit;
  }

  #CartDrawer .cart-item__totals .cart-item__old-price {
    font-size: 12px;
    font-weight: 400;
    color: var(--tre-faint);
  }

  #CartDrawer .cart-item__price-wrapper .cart-item__discounted-prices {
    gap: 2px;
  }

  #CartDrawer .cart-item .loading__spinner {
    padding-top: 0;
  }

  #CartDrawer .cart-item__quantity {
    grid-column: 2 / 4;
    grid-row: 2;
    display: block;
    padding: 0;
  }

  #CartDrawer .cart-item__quantity-wrapper {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  #CartDrawer .quantity-popover-container {
    padding: 0;
  }

  /* Variant options, selling plans and the in-details sale price stay hidden:
     the row carries the title and the line total only. */
  #CartDrawer .product-option,
  #CartDrawer .cart-item__details .cart-item__discounted-prices {
    display: none !important;
  }

  /* Product-level discounts sit under the title as small tags in the savings
     colour, matching the discount box in the footer. */
  #CartDrawer .cart-item__details .discounts {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 6px 0 0;
    padding: 0;
    font-family: var(--font-body-family);
    font-size: 11px;
  }

  #CartDrawer .cart-item__details .discounts__discount {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    max-width: 100%;
    padding: 2px 6px;
    border-radius: var(--tre-radius);
    background: rgba(192, 64, 1, 0.07);
    color: var(--tre-terracotta);
    font-weight: 500;
    line-height: 1.4;
  }

  #CartDrawer .cart-item__details .discounts__discount > .icon {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    margin: 0;
    color: inherit;
  }

  #CartDrawer .caption-with-letter-spacing {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: 12px;
  }

  /* --- Quantity stepper --- */
  /* Dawn draws the input border with ::before/::after box-shadows; a plain
     border replaces them so the stepper reads as one outlined control. */
  #CartDrawer .quantity {
    display: inline-flex;
    align-items: stretch;
    width: auto;
    min-height: 0;
    height: 32px;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--tre-faint);
    border-radius: var(--tre-radius);
  }

  #CartDrawer .quantity::before,
  #CartDrawer .quantity::after {
    display: none;
  }

  #CartDrawer .quantity__button {
    flex: 0 0 28px;
    width: 28px;
    height: 100%;
    padding: 0;
    color: #4b5563;
    background: transparent;
    border: 0;
    transition: background-color 0.2s ease;
  }

  #CartDrawer .quantity__button:not([disabled]):hover {
    background-color: var(--tre-hairline);
  }

  /* The stepper clips overflow for its outline, which would also clip a focus
     ring drawn outside the buttons, so the ring is drawn inside them. */
  #CartDrawer .quantity__button:focus-visible,
  #CartDrawer .quantity__input:focus-visible {
    outline: 2px solid var(--tre-ink);
    outline-offset: -2px;
    box-shadow: none;
  }

  #CartDrawer .quantity__button .svg-wrapper,
  #CartDrawer .quantity__button svg {
    width: 9px;
    height: 9px;
  }

  #CartDrawer .quantity__input {
    flex: 0 0 32px;
    width: 32px;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    font-family: var(--font-body-family);
    font-size: 12px;
    font-weight: 600;
    color: var(--tre-ink-soft);
    text-align: center;
    opacity: 1;
    -moz-appearance: textfield;
    appearance: textfield;
  }

  #CartDrawer .quantity__input::-webkit-outer-spin-button,
  #CartDrawer .quantity__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* --- Remove --- */
  #CartDrawer cart-remove-button {
    display: inline-flex;
    margin: 0;
  }

  #CartDrawer .cart-remove-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    height: auto;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 4px;
    color: var(--tre-faint);
    background: transparent;
    border: 0;
    box-shadow: none;
    opacity: 1;
    transition: color 0.2s ease;
  }

  #CartDrawer .cart-remove-button::before,
  #CartDrawer .cart-remove-button::after {
    display: none;
  }

  #CartDrawer .cart-remove-button:hover {
    color: #dc2626;
  }

  /* Dawn's .button focus ring is a box-shadow, which the rule above clears. */
  #CartDrawer .cart-remove-button:focus-visible,
  #CartDrawer .drawer__inner-empty .button:focus-visible {
    outline: 2px solid var(--tre-ink);
    outline-offset: 2px;
  }

  #CartDrawer .cart-remove-button .svg-wrapper {
    width: 16px;
    height: 16px;
  }

  /* ===========================
     FOOTER
  =========================== */
  #CartDrawer .drawer__footer {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: var(--tre-gutter);
    background: #fff;
    border-top: 1px solid var(--tre-hairline);
    box-shadow: 0 -8px 24px -12px rgba(0, 0, 0, 0.08);
  }

  /* Cart note, when enabled, is a light outlined disclosure above the totals. */
  #CartDrawer .drawer__footer > details {
    margin: 0;
    padding: 0 12px;
    border: 1px solid var(--tre-hairline);
    border-radius: var(--tre-radius);
  }

  #CartDrawer .drawer__footer > details[open] {
    padding-bottom: 12px;
  }

  #CartDrawer .drawer__footer > details + .cart-drawer__footer {
    padding-top: 0;
  }

  #CartDrawer .cart-drawer__footer,
  #CartDrawer .cart__ctas {
    margin: 0;
    padding: 0;
    background: none;
  }

  #CartDrawer .cart-drawer__footer > * + * {
    margin-top: 0;
  }

  /* --- Applied discounts --- */
  /* A coupon: dashed edge and a faint wash in the savings colour, so it reads
     as money off rather than as another line of totals. Each discount is one
     row - name on the start side, amount off on the end side. */
  #CartDrawer .cart-drawer__discounts {
    padding: 10px 12px;
    background: rgba(192, 64, 1, 0.04);
    border: 1px dashed rgba(192, 64, 1, 0.4);
    border-radius: var(--tre-radius);
  }

  #CartDrawer .cart-drawer__discount-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
  }

  #CartDrawer .cart-drawer__discount {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-body-family);
    font-size: 13px;
    line-height: 1.4;
  }

  #CartDrawer .cart-drawer__discount-name {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    font-weight: 500;
    color: var(--tre-ink);
  }

  #CartDrawer .cart-drawer__discount-name .icon-discount {
    flex-shrink: 0;
    width: 13px;
    height: 13px;
    color: var(--tre-terracotta);
  }

  #CartDrawer .cart-drawer__discount-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* A typed code reads like a code; an automatic discount keeps its wording. */
  #CartDrawer .cart-drawer__discount--code .cart-drawer__discount-title {
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  [dir="rtl"] #CartDrawer .cart-drawer__discount--code .cart-drawer__discount-title {
    letter-spacing: 0;
  }

  #CartDrawer .cart-drawer__discount-amount {
    flex-shrink: 0;
    font-weight: 600;
    color: var(--tre-terracotta);
    white-space: nowrap;
  }

  /* --- Totals --- */
  #CartDrawer .cart-drawer__summary {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 0;
    font-family: var(--font-body-family);
  }

  #CartDrawer .cart-drawer__summary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: 12px;
    line-height: 1.4;
    color: var(--tre-muted);
  }

  #CartDrawer .cart-drawer__summary-value {
    font-weight: 500;
    color: var(--tre-ink-soft);
    white-space: nowrap;
  }

  #CartDrawer .cart-drawer__summary-row--total .cart-drawer__summary-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--tre-ink);
  }

  #CartDrawer .cart-drawer__summary-row--total .cart-drawer__summary-value {
    font-size: 18px;
    font-weight: 700;
    color: var(--tre-ink);
  }

  #CartDrawer .cart-drawer__summary-row--savings .cart-drawer__summary-value {
    color: var(--tre-terracotta);
  }

  /* --- Checkout --- */
  #CartDrawer .cart__checkout-button {
    --shadow-opacity: 0;
    width: 100%;
    max-width: none;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 14px 16px;
    border: 0;
    border-radius: var(--tre-radius);
    background-color: var(--tre-terracotta);
    color: #fff;
    font-family: var(--font-body-family);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.025em;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    outline: none;
    transition: background-color 0.2s ease;
  }

  #CartDrawer .cart__checkout-button:not([disabled]):hover {
    background-color: var(--tre-terracotta-hover);
  }

  #CartDrawer .cart__checkout-button[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  #CartDrawer .cart__checkout-button:focus-visible {
    outline: 2px solid var(--tre-terracotta);
    outline-offset: 2px;
  }

  /* Dawn paints button borders and shadows on these pseudo-elements. */
  #CartDrawer .cart__checkout-button::after,
  #CartDrawer .cart__checkout-button::before {
    box-shadow: none !important;
  }

  @media screen and (min-width: 640px) {
    #CartDrawer .cart__checkout-button {
      font-size: 16px;
    }
  }

  /* --- Checkout glare (matches the ATC button: 0.6s, on hover, snaps back) --- */
  @keyframes drawer-glare-ltr {
    from { left: -100%; opacity: 1; }
    to   { left:  100%; opacity: 1; }
  }
  @keyframes drawer-glare-rtl {
    from { right: -100%; opacity: 1; }
    to   { right:  100%; opacity: 1; }
  }

  #CartDrawer-Checkout {
    overflow: hidden;
  }

  #CartDrawer-Checkout span {
    position: relative;
    z-index: 3;
    display: block;
    width: 100%;
  }

  /* Parked off-screen and invisible by default. */
  #CartDrawer-Checkout span::before {
    content: '';
    position: absolute;
    top: -100%;
    left: -100%;
    width: 100%;
    height: 300%;
    opacity: 0;
    background: linear-gradient(120deg, transparent, rgba(255,255,255,0.3), transparent);
    z-index: 2;
    pointer-events: none;
  }

  #CartDrawer-Checkout:not([disabled]):hover span::before {
    animation: drawer-glare-ltr 0.6s linear;
  }

  [dir="rtl"] #CartDrawer-Checkout span::before {
    background: linear-gradient(-120deg, transparent, rgba(255,255,255,0.3), transparent);
    left: auto;
    right: -100%;
  }

  [dir="rtl"] #CartDrawer-Checkout:not([disabled]):hover span::before {
    animation: drawer-glare-rtl 0.6s linear;
  }

  /* --- Trust marks --- */
  /* The check is first in the DOM and every gap is logical, so an RTL
     container flips the check to the right of its label with no [dir] rule. */
  #CartDrawer .cart-drawer__trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px 12px;
    margin-top: 4px;
    padding: 0;
    font-family: var(--font-body-family);
    font-size: 11px;
    line-height: 1.3;
    color: var(--tre-muted);
    opacity: 1;
  }

  #CartDrawer .cart-drawer__trust-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
  }

  #CartDrawer .cart-drawer__trust-check {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--tre-faint);
  }

  #CartDrawer .cart-drawer__trust-check svg {
    display: block;
    width: 9px;
    height: 9px;
  }

  /* --- Payment logos --- */
  /* The footer's 16px gap plus this pulls the logos to 12px under the trust
     row, so the two read as one block. */
  #CartDrawer .cart-drawer__payment-icons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: -4px;
    padding: 0;
    background: transparent;
    opacity: 0.9;
  }

  #CartDrawer .cart-drawer__payment-icon {
    display: block;
    width: auto;
    height: 22px;
    max-width: 42px;
    border-radius: var(--tre-radius);
  }

  /* ===========================
     EMPTY STATE
  =========================== */
  #CartDrawer .drawer__inner-empty {
    padding: 0 24px;
    background: #fff;
  }

  #CartDrawer .cart-drawer__empty-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  #CartDrawer .cart__empty-text {
    margin: 0 0 20px;
    font-family: var(--font-heading-family);
    font-size: 18px;
    font-weight: 400;
    line-height: 1.4;
    color: var(--tre-ink-soft);
  }

  #CartDrawer .drawer__inner-empty .button {
    min-height: 0;
    padding: 12px 24px;
    border-radius: var(--tre-radius);
    background-color: #27231e;
    color: #fff;
    font-family: var(--font-body-family);
    font-size: 14px;
    font-weight: 500;
    box-shadow: none;
  }

  #CartDrawer .drawer__inner-empty .button::before,
  #CartDrawer .drawer__inner-empty .button::after {
    box-shadow: none;
  }

  #CartDrawer .cart__login-title {
    margin: 28px 0 4px;
    font-size: 14px;
  }

  #CartDrawer .cart__login-paragraph {
    margin: 0;
    font-size: 12px;
    color: var(--tre-muted);
  }

  /* ===========================
     RTL
     Layout is flex/grid with logical alignment, so it mirrors on its own.
     Only letter-spacing needs undoing: tracking pulls Arabic letters apart
     and breaks the joins between them.
  =========================== */
  [dir="rtl"] #CartDrawer .cart-items__header,
  [dir="rtl"] #CartDrawer .cart__checkout-button {
    letter-spacing: 0;
  }

  /* ===========================
     SHARED WITH THE /cart PAGE AND HEADER MENU
     This snippet renders on every page, so these unscoped rules have long been
     styling main-cart-footer, main-cart-items and Dawn's header drawer too.
     They are kept as they were so the drawer restyle does not move anything
     outside the drawer. The drawer's own versions above are #CartDrawer-scoped
     and win inside it.
  =========================== */
  .totals__total,
  .totals__total-value,
  .tax-note {
    font-family: var(--font-body-family);
  }

  .cart__ctas {
    padding-top: 0.75rem;
  }

  .cart__checkout-button:not(#CartDrawer-Checkout) {
    --color-button: 192, 64, 1;
    --color-button-text: 255, 255, 255;
    --shadow-opacity: 0;
    background-color: #c04001;
    color: #ffffff;
    font-family: var(--font-body-family);
    border: 1px solid #c04001 !important;
    border-radius: 2px;
    outline: none;
    box-shadow: none;
  }

  .cart__checkout-button:not(#CartDrawer-Checkout)::after,
  .cart__checkout-button:not(#CartDrawer-Checkout)::before,
  .cart__checkout-button:not(#CartDrawer-Checkout):focus::after,
  .cart__checkout-button:not(#CartDrawer-Checkout):focus-visible::after {
    box-shadow: none !important;
  }

  .cart__checkout-button:not(#CartDrawer-Checkout):focus,
  .cart__checkout-button:not(#CartDrawer-Checkout):focus-visible {
    outline: none;
    box-shadow: none;
  }

  [dir="rtl"] .cart-item__totals {
    text-align: left;
    justify-content: flex-start;
  }

  .drawer__close {
    flex-shrink: 0;
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
  }

  [dir="rtl"] .drawer__close {
    right: auto;
    left: 1.5rem;
  }

  /* ===========================
     UPSELL (styles for the CartUpsell script below; no markup renders it yet)
  =========================== */
  .cart-drawer__upsell-wrapper {
    padding: 1rem;
    background-color: #fafafa;
    border-top: 1px solid rgba(0,0,0,0.05);
  }

  .cart-drawer__upsell-title {
    font-size: var(--t-small);
    margin-bottom: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-family: var(--font-body-family);
  }

  [dir="rtl"] .cart-drawer__upsell-title {
    text-align: right;
  }

  .upsell-scroll-container {
    display: flex;
    overflow-x: auto;
    gap: 0.75rem;
    padding-bottom: 0.5rem;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  [dir="rtl"] .upsell-scroll-container {
    direction: rtl;
  }

  .upsell-item {
    flex: 0 0 auto;
    scroll-snap-align: start;
    border: 1px solid #e1e1e1;
    border-radius: 6px;
    background: white;
    padding: 0.5rem;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
    min-width: 280px;
    max-width: 320px;
  }

  .upsell-item img {
    width: 60px;
    height: auto;
    display: block;
    border-radius: 6px;
    flex-shrink: 0;
  }

  .upsell-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .upsell-info h4 {
    font-size: var(--t-small);
    margin: 0;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    font-family: var(--font-heading-family);
  }

  .upsell-btn {
    background: black;
    color: white;
    border: none;
    padding: 0.5rem 0.75rem;
    font-size: var(--t-small);
    cursor: pointer;
    border-radius: 4px;
    transition: background 0.2s;
    white-space: nowrap;
    flex-shrink: 0;
    font-family: var(--font-body-family);
  }

  .upsell-btn:hover {
    background: #333;
  }

  .upsell-btn.loading {
    opacity: 0.7;
    pointer-events: none;
  }

  @media screen and (max-width: 750px) {
    .cart-drawer__upsell-title {
      margin-bottom: 0.5rem;
    }
    .cart-drawer__upsell-wrapper {
      padding: 0.75rem;
    }
    .upsell-item {
      min-width: 260px;
      max-width: 280px;
      padding: 0.4rem;
    }
    .upsell-item img {
      width: 50px;
      height: 50px;
    }
    .upsell-btn {
      padding: 0.4rem 0.6rem;
    }
  }
</style>

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner gradient color-{{ settings.cart_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      {%- if cart == empty -%}
        <div class="drawer__inner-empty">
          <div class="cart-drawer__warnings center{% if settings.cart_drawer_collection != blank %} cart-drawer__warnings--has-collection{% endif %}">
            <div class="cart-drawer__empty-content">
              <h2 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h2>
              <button
                class="drawer__close"
                type="button"
                onclick="this.closest('cart-drawer').close()"
                aria-label="{{ 'accessibility.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
              <a href="{{ routes.all_products_collection_url }}" class="button">
                {{ 'general.continue_shopping' | t }}
              </a>

              {%- if shop.customer_accounts_enabled and customer == null -%}
                <p class="cart__login-title h3">{{ 'sections.cart.login.title' | t }}</p>
                <p class="cart__login-paragraph">
                  {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
                </p>
              {%- endif -%}
            </div>
          </div>
          {%- if settings.cart_drawer_collection != blank -%}
            <div class="cart-drawer__collection">
              {% render 'card-collection', card_collection: settings.cart_drawer_collection, columns: 1 %}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="drawer__header">
        <h2 class="drawer__heading">{{ 'sections.cart.title' | t }}</h2>
        <button
          class="drawer__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>

      {%- comment -%} SINGLE PROGRESS BAR IMPLEMENTATION {%- endcomment -%}
      {% render 'progress-bar-v2', threshold: 500, show_when_empty: true %}

      <cart-drawer-items
        {% if cart == empty %}
          class=" is-empty"
        {% endif %}
      >
        <form
          action="{{ routes.cart_url }}"
          id="CartDrawer-Form"
          class="cart__contents cart-drawer__form"
          method="post"
        >
          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {%- if cart != empty -%}
              <div class="drawer__cart-items-wrapper">
                <table class="cart-items" role="table">
                  <thead class="cart-items__header" role="rowgroup">
                    <tr class="cart-items__header-row" role="row">
                      <th class="cart-items__header-cell" role="columnheader">{{ 'sections.cart.headings.product' | t }}</th>
                      <th class="cart-items__header-cell" role="columnheader">{{ 'sections.cart.headings.total' | t }}</th>
                    </tr>
                  </thead>
                  <tbody class="cart-items__body" role="rowgroup">
                    {%- for item in cart.items -%}
                      <tr
                        id="CartDrawer-Item-{{ item.index | plus: 1 }}"
                        class="cart-item{% if item.parent_relationship.parent != null %} cart-item__nested-line{% endif %}"
                        role="row"
                        {% if item.parent_relationship.parent != null %}
                          aria-label="{{- 'products.product.nested_label' | t: title: item.product.title, parent_title: item.parent_relationship.parent.title | escape -}}"
                        {% endif %}
                      >
                        <td class="cart-item__media" role="cell">
                          {% if item.image %}
                            <a href="{{ item.url }}" class="cart-item__link" tabindex="-1" aria-hidden="true"> </a>
                            <img
                              class="cart-item__image"
                              src="{{ item.image | image_url: width: 300 }}"
                              alt="{{ item.image.alt | escape }}"
                              loading="lazy"
                              width="150"
                              height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                            >
                          {% endif %}
                        </td>

                        <td class="cart-item__details" role="cell">
                          {%- if settings.show_vendor -%}
                            <p class="caption-with-letter-spacing light">{{ item.product.vendor }}</p>
                          {%- endif -%}

                          <a href="{{ item.url }}" class="cart-item__name h4 break">
                            {{- item.product.title | escape -}}
                          </a>

                          {%- if item.product.has_only_default_variant == false
                            or item.properties.size != 0
                            or item.selling_plan_allocation != null
                          -%}
                            <dl>
                              {%- if item.product.has_only_default_variant == false -%}
                                {%- for option in item.options_with_values -%}
                                  <div class="product-option">
                                    <dt>{{ option.name }}:</dt>
                                    <dd>
                                      {{ option.value -}}
                                      {%- unless forloop.last %}, {% endunless %}
                                    </dd>
                                  </div>
                                {%- endfor -%}
                              {%- endif -%}

                              {%- for property in item.properties -%}
                                {%- assign property_first_char = property.first | slice: 0 -%}
                                {%- if property.last != blank and property_first_char != '_' -%}
                                  <div class="product-option">
                                    <dt>{{ property.first }}:</dt>
                                    <dd>
                                      {%- if property.last contains '/uploads/' -%}
                                        <a
                                          href="{{ property.last }}"
                                          class="link"
                                          target="_blank"
                                          aria-describedby="a11y-new-window-message"
                                        >
                                          {{ property.last | split: '/' | last }}
                                        </a>
                                      {%- else -%}
                                        {{ property.last }}
                                      {%- endif -%}
                                    </dd>
                                  </div>
                                {%- endif -%}
                              {%- endfor -%}
                            </dl>

                            <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                          {%- endif -%}

                          <ul
                            class="discounts list-unstyled"
                            role="list"
                            aria-label="{{ 'customer.order.discount' | t }}"
                          >
                            {%- for discount in item.line_level_discount_allocations -%}
                              <li class="discounts__discount">
                                {{- 'icon-discount.svg' | inline_asset_content -}}
                                {{ discount.discount_application.title }}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </td>

                        <td class="cart-item__totals" role="cell">
                          {%- render 'loading-spinner' -%}
                          <div class="cart-item__price-wrapper">
                            {%- if item.original_line_price != item.final_line_price -%}
                              <div class="cart-item__discounted-prices">
                                <span class="visually-hidden">
                                  {{ 'products.product.price.regular_price' | t }}
                                </span>
                                <s class="cart-item__old-price price price--end">
                                  {{ item.original_line_price | money }}
                                </s>
                                <span class="visually-hidden">
                                  {{ 'products.product.price.sale_price' | t }}
                                </span>
                                <span class="price price--end">
                                  {{ item.final_line_price | money }}
                                </span>
                              </div>
                            {%- else -%}
                              <span class="price price--end">
                                {{ item.original_line_price | money }}
                              </span>
                            {%- endif -%}
                          </div>
                        </td>
                        {%- liquid
                          assign has_qty_rules = false
                          if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                            assign has_qty_rules = true
                          endif

                          assign has_vol_pricing = false
                          if item.variant.quantity_price_breaks.size > 0
                            assign has_vol_pricing = true
                          endif
                        -%}
                        <td
                          class="cart-item__quantity {% if has_qty_rules or has_vol_pricing %} cart-item__quantity--info{% endif %}"
                          role="cell"
                        >
                          <quantity-popover>
                            <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                              <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                                <quantity-input class="quantity cart-quantity">
                                  <button
                                    class="quantity__button"
                                    name="minus"
                                    type="button"
                                    {% if item.instructions and item.instructions.can_update_quantity == false %}
                                      disabled
                                    {% endif %}
                                  >
                                    <span class="visually-hidden">
                                      {{-
                                        'products.product.quantity.decrease'
                                        | t: product: item.product.title
                                        | escape
                                      -}}
                                    </span>
                                    <span class="svg-wrapper">
                                      {{- 'icon-minus.svg' | inline_asset_content -}}
                                    </span>
                                  </button>
                                  <input
                                    class="quantity__input"
                                    type="number"
                                    data-quantity-variant-id="{{ item.variant.id }}"
                                    name="updates[]"
                                    value="{{ item.quantity }}"
                                    {% # theme-check-disable %}
                                    data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                    min="0"
                                    data-min="{{ item.variant.quantity_rule.min }}"
                                    {% if item.variant.quantity_rule.max != null %}
                                      max="{{ item.variant.quantity_rule.max }}"
                                    {% endif %}
                                    step="{{ item.variant.quantity_rule.increment }}"
                                    {% # theme-check-enable %}
                                    aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                    id="Drawer-quantity-{{ item.index | plus: 1 }}"
                                    data-index="{{ item.index | plus: 1 }}"
                                    {% if item.instructions and item.instructions.can_update_quantity == false %}
                                      disabled
                                    {% endif %}
                                  >
                                  <button
                                    class="quantity__button"
                                    name="plus"
                                    type="button"
                                    {% if item.instructions and item.instructions.can_update_quantity == false %}
                                      disabled
                                    {% endif %}
                                  >
                                    <span class="visually-hidden">
                                      {{-
                                        'products.product.quantity.increase'
                                        | t: product: item.product.title
                                        | escape
                                      -}}
                                    </span>
                                    <span class="svg-wrapper">
                                      {{- 'icon-plus.svg' | inline_asset_content -}}
                                    </span>
                                  </button>
                                </quantity-input>
                              </div>
                              <cart-remove-button
                                id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                                data-index="{{ item.index | plus: 1 }}"
                              >
                                <button
                                  type="button"
                                  class="button button--tertiary cart-remove-button"
                                  aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                                  data-variant-id="{{ item.variant.id }}"
                                  {% if item.instructions and item.instructions.can_remove == false %}
                                    class="hidden"
                                  {% endif %}
                                >
                                  <span class="svg-wrapper">
                                    {{- 'icon-remove.svg' | inline_asset_content -}}
                                  </span>
                                </button>
                              </cart-remove-button>
                            </div>
                            {%- if has_qty_rules or has_vol_pricing -%}
                              <button
                                type="button"
                                class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary"
                                aria-expanded="false"
                              >
                                <span class="svg-wrapper">
                                  {{- 'icon-info.svg' | inline_asset_content -}}
                                </span>
                                <span>
                                  {%- if has_vol_pricing -%}
                                    {{ 'products.product.volume_pricing.note' | t }}
                                  {%- elsif has_qty_rules -%}
                                    {{ 'products.product.quantity.note' | t }}
                                  {%- endif -%}
                                </span>
                              </button>
                            {%- endif -%}
                            {%- if has_vol_pricing or has_qty_rules -%}
                              <div
                                class="cart-items__info global-settings-popup quantity-popover__info"
                                tabindex="-1"
                                hidden
                              >
                                {%- if has_qty_rules == false -%}
                                  <span class="volume-pricing-label caption">
                                    {{- 'products.product.volume_pricing.title' | t -}}
                                  </span>
                                {%- endif -%}
                                <div class="quantity__rules caption">
                                  {%- if item.variant.quantity_rule.increment > 1 -%}
                                    <span class="divider">
                                      {{-
                                        'products.product.quantity.multiples_of'
                                        | t: quantity: item.variant.quantity_rule.increment
                                      -}}
                                    </span>
                                  {%- endif -%}
                                  {%- if item.variant.quantity_rule.min > 1 -%}
                                    <span class="divider">
                                      {{-
                                        'products.product.quantity.min_of'
                                        | t: quantity: item.variant.quantity_rule.min
                                      -}}
                                    </span>
                                  {%- endif -%}
                                  {%- if item.variant.quantity_rule.max != null -%}
                                    <span class="divider">
                                      {{-
                                        'products.product.quantity.max_of'
                                        | t: quantity: item.variant.quantity_rule.max
                                      -}}
                                    </span>
                                  {%- endif -%}
                                </div>
                                <button
                                  class="button-close button button--tertiary"
                                  type="button"
                                  aria-label="{{ 'accessibility.close' | t }}"
                                >
                                  <span class="svg-wrapper">
                                    {{- 'icon-close.svg' | inline_asset_content -}}
                                  </span>
                                </button>
                                {%- if item.variant.quantity_price_breaks.size > 0 -%}
                                  <volume-pricing class="parent-display">
                                    <ul class="list-unstyled">
                                      <li>
                                        <span>{{ item.variant.quantity_rule.min }}+</span>
                                        <span>{{ item.variant.price | money_with_currency }}/ea</span>
                                      </li>
                                      {%- for price_break in item.variant.quantity_price_breaks -%}
                                        <li>
                                          <span>
                                            {{- price_break.minimum_quantity -}}
                                            <span aria-hidden="true">+</span></span
                                          >
                                          <span>{{ price_break.price | money_with_currency }}/ea</span>
                                        </li>
                                      {%- endfor -%}
                                    </ul>
                                  </volume-pricing>
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                            <div
                              id="CartDrawer-LineItemError-{{ item.index | plus: 1 }}"
                              class="cart-item__error"
                              role="alert"
                            >
                              <small class="cart-item__error-text"></small>
                              <span class="svg-wrapper">
                                {{- 'icon-error.svg' | inline_asset_content -}}
                              </span>
                            </div>
                          </quantity-popover>
                        </td>
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>
              </div>
            {%- endif -%}
            <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
            <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
              {{ 'accessibility.loading' | t }}
            </p>
          </div>
          <div id="CartDrawer-CartErrors" role="alert"></div>
        </form>
      </cart-drawer-items>
      <div class="drawer__footer">
        

        {%- if settings.show_cart_note -%}
          <details id="Details-CartDrawer">
            <summary>
              <span class="summary__title">
                {{ 'sections.cart.note' | t }}
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </summary>
            <cart-note class="cart__note field">
              <label class="visually-hidden" for="CartDrawer-Note">{{ 'sections.cart.note' | t }}</label>
              <textarea
                id="CartDrawer-Note"
                class="text-area text-area--resize-vertical field__input"
                name="note"
                placeholder="{{ 'sections.cart.note' | t }}"
              >{{ cart.note }}</textarea>
            </cart-note>
          </details>
        {%- endif -%}

        {%- comment -%}
          Applied discounts: codes (from checkout or a /discount/ link) and
          automatic discounts, each with what it takes off. Only rendered when
          one applies, so the footer does not grow for everyone else.
        {%- endcomment -%}
        {%- if cart.cart_level_discount_applications.size > 0 -%}
          <div class="cart-drawer__discounts">
            <ul class="cart-drawer__discount-list list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
              {%- for discount in cart.cart_level_discount_applications -%}
                <li class="cart-drawer__discount{% if discount.type == 'discount_code' %} cart-drawer__discount--code{% endif %}">
                  <span class="cart-drawer__discount-name">
                    {{- 'icon-discount.svg' | inline_asset_content -}}
                    <span class="cart-drawer__discount-title">{{ discount.title | escape }}</span>
                  </span>
                  {%- comment -%} dir=ltr keeps the minus in front of the number in Arabic. {%- endcomment -%}
                  <span class="cart-drawer__discount-amount" dir="ltr">-{{ discount.total_allocated_amount | money }}</span>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <!-- Subtotals -->

        <div class="cart-drawer__footer" {{ block.shopify_attributes }}>

          {%- liquid
            assign cart_savings = 0
            for item in cart.items
              if item.variant.compare_at_price > item.variant.price
                assign line_saving = item.variant.compare_at_price | minus: item.variant.price | times: item.quantity
                assign cart_savings = cart_savings | plus: line_saving
              endif
            endfor
            assign cart_savings = cart_savings | plus: cart.total_discount
          -%}
          <div class="cart-drawer__summary" role="status">
            <div class="cart-drawer__summary-row cart-drawer__summary-row--total">
              <span class="cart-drawer__summary-label">{{ 'sections.cart.headings.total' | t }}</span>
              <span class="cart-drawer__summary-value">{{ cart.total_price | money }}</span>
            </div>
            <div class="cart-drawer__summary-row">
              <span class="cart-drawer__summary-label">{{ 'sections.cart.shipping' | t }}</span>
              <span class="cart-drawer__summary-value">
                {%- if cart.total_price >= 50000 -%}
                  {{ 'sections.cart.shipping_free' | t }}
                {%- else -%}
                  {{ 'sections.cart.shipping_at_checkout' | t }}
                {%- endif -%}
              </span>
            </div>
            {%- if cart_savings > 0 -%}
              <div class="cart-drawer__summary-row cart-drawer__summary-row--savings">
                <span class="cart-drawer__summary-label">{{ 'sections.cart.savings' | t }}</span>
                <span class="cart-drawer__summary-value" dir="ltr">-{{ cart_savings | money }}</span>
              </div>
            {%- endif -%}
          </div>

        </div>

        <!-- CTAs -->

        <div class="cart__ctas" {{ block.shopify_attributes }}>
          <button
            type="submit"
            id="CartDrawer-Checkout"
            class="cart__checkout-button button"
            name="checkout"
            form="CartDrawer-Form"
            {% if cart == empty %}
              disabled
            {% endif %}
          >
            <span>{{ 'sections.cart.checkout' | t }}</span>
          </button>

          {%- comment -%}
            Payment logos live in /assets. Any file not present is hidden automatically (onerror).
            To add one: upload pay-NAME.svg to /assets and add it to both lists below.
            Current: pay-applepay, pay-mada, pay-visa, pay-mastercard, pay-amex, pay-tabby, pay-tamara (.svg)
          {%- endcomment -%}
          {%- liquid
            assign payment_icons = 'pay-applepay.svg,pay-mada.svg,pay-visa.svg,pay-mastercard.svg,pay-amex.svg,pay-tabby.svg,pay-tamara.svg' | split: ','
            assign payment_labels = 'Apple Pay,Mada,Visa,Mastercard,American Express,Tabby,Tamara' | split: ','
          -%}
        </div>

        <div class="cart-drawer__trust">
          <span class="cart-drawer__trust-item">
            <span class="cart-drawer__trust-check">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
            <span>{{ 'sections.cart.trust_easy_returns' | t }}</span>
          </span>
          <span class="cart-drawer__trust-item">
            <span class="cart-drawer__trust-check">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
            <span>{{ 'sections.cart.trust_warranty' | t }}</span>
          </span>
          <span class="cart-drawer__trust-item">
            <span class="cart-drawer__trust-check">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
            <span>{{ 'sections.cart.trust_fast_delivery' | t }}</span>
          </span>
        </div>

        {%- comment -%}
          Outside .cart__ctas on purpose: the payment marks sit on the drawer's
          neutral ground below the summary card, not inside it.
        {%- endcomment -%}
        <div class="cart-drawer__payment-icons">
          {%- for icon in payment_icons -%}
            <img
              src="{{ icon | asset_url }}"
              alt="{{ payment_labels[forloop.index0] }}"
              class="cart-drawer__payment-icon"
              width="38"
              height="24"
              loading="lazy"
              onerror="this.remove()"
            >
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

{% javascript %}
  // Upsell Logic
  class CartUpsell {
    constructor() {
        this.init();
    }
    
    init() {
        // Use delegation for buttons since HTML might be re-rendered
        document.body.addEventListener('click', (e) => {
            if(e.target && e.target.classList.contains('js-upsell-add')) {
                this.addUpsell(e.target);
            }
        });
    }

    addUpsell(btn) {
        const variantId = btn.dataset.variantId;
        if(!variantId) return;

        btn.classList.add('loading');
        btn.textContent = 'Adding...';

        let formData = {
            'items': [{
                'id': variantId,
                'quantity': 1
            }]
        };

        fetch(window.Shopify.routes.root + 'cart/add.js', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(formData)
        })
        .then(response => {
            return response.json();
        })
        .then(data => {
            // Trigger cart drawer refresh (Standard Dawn Theme Event)
            const cartDrawer = document.querySelector('cart-drawer');
            if(cartDrawer) {
                 document.querySelector('cart-drawer-items').classList.add('is-loading');
                 
                 // Fetch updated cart sections
                 fetch(window.location.pathname + '?sections=cart-drawer')
                 .then(res => res.json())
                 .then(sections => {
                     const parser = new DOMParser();
                     const doc = parser.parseFromString(sections['cart-drawer'], 'text/html');
                     const newDrawer = doc.querySelector('cart-drawer');
                     if(newDrawer) {
                         document.querySelector('cart-drawer').innerHTML = newDrawer.innerHTML;
                     }
                 });
            }
        })
        .catch(error => {
            console.error('Error:', error);
            btn.textContent = 'Error';
        });
    }
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
        new CartUpsell();
    });
  } else {
    new CartUpsell();
  }
{% endjavascript %}
</cart-drawer>

{% comment %}
  Snippet: Cookware lineup
  Renders the Essential Collection as a grid. Two sources:

    products - an array of products (from a metafield or a picker). Each item
               links to its product. The drawing is taken from the product's
               art metafield when it names one, otherwise the product's
               featured image is used.
    only     - comma separated drawing keys, when there are no products to
               bind to. Keys: frying-pan-20, frying-pan-26, frying-pan-28,
               sauce-pan-16, saute-pan-26, stockpot-20, stockpot-26, steamer-26

  Give it one or the other; `products` wins. With neither, all eight drawings
  render.

  Other params:
    columns      - 2, 3, 4, or 'auto' to match the number of items (max 4).
    heading      - optional heading above the grid.
    show_price   - true to print the price under a product's title.
    art_ns       - product metafield namespace holding the drawing key.
    art_key      - product metafield key holding the drawing key.

  Usage:
    {% render 'cookware-lineup' %}
    {% render 'cookware-lineup', only: 'frying-pan-26,stockpot-26' %}
    {% render 'cookware-lineup', products: collection.metafields.custom.lineup_products.value %}
{% endcomment %}

{%- liquid
  assign keys = 'frying-pan-20,frying-pan-26,frying-pan-28,sauce-pan-16,saute-pan-26,stockpot-20,stockpot-26,steamer-26' | split: ','
  assign widths = '796,900,900,752,900,736,832,836' | split: ','
  assign heights = '244,233,232,388,330,412,472,312' | split: ','

  if request.locale.iso_code contains 'ar'
    assign sizes = '20 سم,26 سم,28 سم,16 سم,26 سم,20 سم,26 سم,26 سم' | split: ','
    assign names = 'مقلاة,مقلاة,مقلاة,قدر صلصة,مقلاة سوتيه,قدر صغير,قدر كبير,قدر البخار' | split: ','
  else
    assign sizes = '20cm,26cm,28cm,16cm,26cm,20cm,26cm,26cm' | split: ','
    assign names = 'Frying Pan,Frying Pan,Frying Pan,Sauce Pan,Sauté Pan,Stockpot,Stockpot,Steamer' | split: ','
  endif

  assign ns = art_ns | default: 'custom'
  assign akey = art_key | default: 'lineup_art'

  assign use_products = false
  if products != blank and products.size > 0
    assign use_products = true
    assign count = products.size
  else
    assign wanted = keys
    if only != blank
      assign wanted = only | split: ','
    endif
    assign count = wanted.size
  endif

  assign cols = columns | default: 'auto'
  if cols == 'auto'
    assign cols = count
    if cols > 4
      assign cols = 4
    endif
  endif
-%}

{{ 'cookware-lineup.css' | asset_url | stylesheet_tag }}

<div class="tre-lineup">
  {%- if heading != blank -%}
    <h2 class="tre-lineup__heading">{{ heading }}</h2>
  {%- endif -%}

  <div class="tre-lineup__grid tre-lineup__grid--{{ cols }}">
    {%- if use_products -%}

      {%- for item in products -%}
        {%- liquid
          assign art = item.metafields[ns][akey].value | default: '' | strip
          assign i = -1
          if art != blank
            for candidate in keys
              if candidate == art
                assign i = forloop.index0
                break
              endif
            endfor
          endif
        -%}
        <a class="tre-lineup__item" href="{{ item.url }}">
          <div class="tre-lineup__art">
            {%- if i >= 0 -%}
              <img
                src="{{ 'guide-' | append: art | append: '.png' | asset_url }}"
                alt="{{ item.title | escape }}"
                width="{{ widths[i] }}"
                height="{{ heights[i] }}"
                loading="lazy"
              >
            {%- elsif item.featured_image -%}
              {{
                item.featured_image
                | image_url: width: 600
                | image_tag: loading: 'lazy', widths: '200,300,400,600', alt: item.title
              }}
            {%- endif -%}
          </div>
          <p class="tre-lineup__label">
            {{ item.title }}
            {%- if show_price -%}
              <span class="tre-lineup__price">{{ item.price | money }}</span>
            {%- endif -%}
          </p>
        </a>
      {%- endfor -%}

    {%- else -%}

      {%- for key in wanted -%}
        {%- liquid
          assign k = key | strip
          assign i = -1
          for candidate in keys
            if candidate == k
              assign i = forloop.index0
              break
            endif
          endfor
        -%}
        {%- if i >= 0 -%}
          <div class="tre-lineup__item">
            <div class="tre-lineup__art">
              <img
                src="{{ 'guide-' | append: k | append: '.png' | asset_url }}"
                alt="{{ sizes[i] }} {{ names[i] }}"
                width="{{ widths[i] }}"
                height="{{ heights[i] }}"
                loading="lazy"
              >
            </div>
            <p class="tre-lineup__label">{{ sizes[i] }}<br>{{ names[i] }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}

    {%- endif -%}
  </div>
</div>

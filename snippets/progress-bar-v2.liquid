{% comment %}
  STATE OF THE ART PROGRESS BAR
  - Configuration: Change 'free_shipping_threshold' below (value in cents, e.g., 5000 = $50.00)
{% endcomment %}

{%- liquid
  assign free_shipping_threshold = 50000
  assign current_total = cart.total_price
  assign remaining_amount = free_shipping_threshold | minus: current_total
  
  assign progress_percentage = current_total | times: 100.0 | divided_by: free_shipping_threshold
  if progress_percentage > 100
    assign progress_percentage = 100
  endif
-%}

<div class="shipping-progress-wrapper"
     data-shipping-wrapper
     {%- comment -%}
       The total this markup was rendered against. Section HTML swapped in after
       a cart change is authoritative and arrives with no extra round-trip, so
       the script adopts this instead of repainting from the total it happens to
       be holding.
     {%- endcomment -%}
     data-cart-total="{{ cart.total_price }}"
     data-threshold="{{ free_shipping_threshold }}"
     data-currency="{{ cart.currency.iso_code }}"
     data-text-remaining="{{ 'sections.cart.progress_bar.add_for_free_shipping' | t: amount: 'AMOUNT_PLACEHOLDER' | escape }}"
     data-text-unlocked="{{ 'sections.cart.progress_bar.free_shipping_unlocked' | t | escape }}">
  
  <div class="shipping-progress-bar">
    <div class="shipping-progress-fill" 
         style="width: {{ progress_percentage }}%;">
      <span class="shipping-progress-shine"></span>
    </div>
  </div>

  <div class="shipping-progress-text">
    {%- if remaining_amount > 0 -%}
      {%- assign remaining_formatted = remaining_amount | money -%}
      <p>{{ 'sections.cart.progress_bar.add_for_free_shipping' | t: amount: remaining_formatted }}</p>
    {%- else -%}
      <p class="success-text">{{ 'sections.cart.progress_bar.free_shipping_unlocked' | t }}</p>
    {%- endif -%}
  </div>
</div>

<style>
  .shipping-progress-wrapper {
    width: 100%;
    padding: 15px 0;
    display: block;
  }
  
  .shipping-progress-bar {
    background: linear-gradient(288deg,rgba(232, 248, 255, 0.38) 0%,rgb(238, 238, 238) 100%);
    height: 10px;
    border-radius: 0px;
    overflow: hidden;
    position: relative;
    width: 100%;
    margin-bottom: 8px;
  }
  
  .shipping-progress-fill {
    background: linear-gradient(288deg, #c0ddea 0%, #c0ddea 100%);
    height: 100%;
    border-radius: 0px;
    transition: width 0.4s cubic-bezier(0.25, 1, 0.5, 1); /* Smooth eased transition */
    position: relative;
    min-width: 2%; /* Ensure visibility even at low amounts */
  }

  /* Optional: Adds a shiny animation effect */
  .shipping-progress-shine {
    position: absolute;
    display: flex;
    top: 0;
    left: 0;
    bottom: 0;
    width: 100%;
    background: linear-gradient(
      90deg, 
      rgba(196, 32, 32, 0) 0%, 
      rgba(255, 255, 255, 0.4) 50%, 
      rgba(29, 12, 12, 0) 100%
    );
    transform: translateX(-100%);
    animation: shimmer 3s linear infinite;
  }

  @keyframes shimmer {
    100% { transform: translateX(100%); }
  }

  .shipping-progress-text p {
    margin: 0;
    font-size: 14px;
    text-align: center;
    color: #333;
  }

  .shipping-progress-text strong {
    font-weight: bold;
    color: #000;
  }

  .success-text {
    color:rgb(27, 199, 96) !important;
    font-weight: bold;
  }
</style>

<script>
(function() {
  // CONFIGURATION
  // We use a global variable to share state across re-renders
  window.shippingBarState = window.shippingBarState || {
    total: {{ cart.total_price }}, // Initialize with Liquid
    threshold: {{ free_shipping_threshold }},
    currency: "{{ cart.currency.iso_code }}"
  };

  const formatMoney = (cents, currency) => {
    return new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: currency
    }).format(cents / 100);
  };

  const updateDOM = () => {
    // Select ALL instances of the bar (Cart drawer + Main page + Cart page)
    const wrappers = document.querySelectorAll('[data-shipping-wrapper]');
    
    wrappers.forEach(wrapper => {
      const fill = wrapper.querySelector('.shipping-progress-fill');
      const textDiv = wrapper.querySelector('.shipping-progress-text');
      
      if (!fill || !textDiv) return;

      const { total, threshold, currency } = window.shippingBarState;
      
      // Calculate Math
      let percentage = (total / threshold) * 100;
      if (percentage > 100) percentage = 100;
      if (percentage < 0) percentage = 0;
      
      const remaining = threshold - total;

      // Update Visuals
      fill.style.width = `${percentage}%`;

      // Update Text
      if (remaining > 0) {
        const template = wrapper.dataset.textRemaining || 'Add AMOUNT_PLACEHOLDER for free shipping';
        const text = template.replace('AMOUNT_PLACEHOLDER', `<strong>${formatMoney(remaining, currency)}</strong>`);
        textDiv.innerHTML = `<p>${text}</p>`;
      } else {
        const unlockedText = wrapper.dataset.textUnlocked || '🎉 You qualify for free shipping!';
        textDiv.innerHTML = `<p class="success-text">${unlockedText}</p>`;
      }
    });
  };

  // 1. Listen for Shopify Fetch Events (The standard way themes update)
  // We hook into the fetch API to detect cart changes instantly
  const originalFetch = window.fetch;
  window.fetch = async function (...args) {
    const response = await originalFetch(...args);
    
    const url = args[0].toString();
    
    // Check if this request was a cart update
    if (url.includes('/cart/add') || 
        url.includes('/cart/change') || 
        url.includes('/cart/update')) {
      
      // FIX: If it is an 'add' event, the response is only the item, not the total.
      // We must fetch the full cart manually to get the accurate total.
      if (url.includes('/cart/add')) {
         fetchCartManually();
      } else {
         // For change/update, Shopify usually returns the full cart, but to be safe 
         // and consistent, we verify data keys exist.
         const clone = response.clone();
         try {
           const data = await clone.json();
           
           // If the response has a total_price (full cart object), use it.
           if (typeof data.total_price !== 'undefined') {
             window.shippingBarState.total = data.total_price;
             updateDOM();
           } else {
             // If response doesn't have total_price, fetch manually
             fetchCartManually();
           }
         } catch (e) {
           fetchCartManually();
         }
      }
    }
    return response;
  };

  const fetchCartManually = () => {
    fetch(window.Shopify.routes.root + 'cart.js')
      .then(res => res.json())
      .then(cart => {
        window.shippingBarState.total = cart.total_price;
        updateDOM();
      });
  };

  // 2. Observer for HTML replacements: a re-rendered drawer brings a new bar.
  //
  // This used to repaint the new markup from whatever total this script was
  // holding. On a first add that total is still 0 - the cart was empty when the
  // page rendered - so a correct server-rendered bar was immediately painted
  // back to empty, and stayed there until the /cart.js round-trip below
  // returned. That round-trip is slowest on a first add, when the cart cookie is
  // still being issued, which is exactly when the stall was visible.
  //
  // The incoming markup already carries the total it was rendered against, so
  // adopt that and paint once, correctly, with nothing to wait for.
  const findWrapper = (node) => {
    if (node.nodeType !== 1) return null;
    if (node.matches && node.matches('[data-shipping-wrapper]')) return node;
    return node.querySelector ? node.querySelector('[data-shipping-wrapper]') : null;
  };

  const observer = new MutationObserver((mutations) => {
    let fresh = null;
    for (const mutation of mutations) {
      for (const node of mutation.addedNodes) {
        fresh = findWrapper(node);
        if (fresh) break;
      }
      if (fresh) break;
    }
    if (!fresh) return;

    // Read from the node that actually arrived. Another bar elsewhere on the
    // page (the cart page's own) was not re-rendered and still carries the old
    // total, so picking the first match in the document could adopt a stale one.
    const rendered = parseInt(fresh.dataset.cartTotal, 10);
    if (!Number.isNaN(rendered)) window.shippingBarState.total = rendered;

    updateDOM();
  });

  observer.observe(document.body, { childList: true, subtree: true });

  // 3. Standard Events
  document.addEventListener('DOMContentLoaded', updateDOM);
  document.addEventListener('cart:updated', fetchCartManually); // Legacy themes
})();
</script>